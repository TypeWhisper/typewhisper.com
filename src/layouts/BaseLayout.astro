---
import "@/index.css";
import { getClientMessages } from "@/i18n/client-messages";
import { Header } from "@/components/layout/header";
import DownloadSocialBanner from "@/components/layout/download-social-banner.astro";
import Footer from "@/components/layout/footer.astro";
import type { Locale } from "@/i18n/index";
import { ogLocale, localePath } from "@/i18n/index";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  locale?: Locale;
  ogImage?: string;
  searchPlatforms?: string[];
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  canonicalPath,
  locale = "en",
  ogImage = "https://www.typewhisper.com/og-image.png",
  structuredData,
  searchPlatforms = [],
} = Astro.props;

const canonicalUrl = `https://www.typewhisper.com${canonicalPath}`;
const basePath = canonicalPath.replace(/^\/(en|de)/, "") || "/";
const deUrl = `https://www.typewhisper.com${localePath("de", basePath)}`;
const enUrl = `https://www.typewhisper.com${localePath("en", basePath)}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/GeneralSans-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="theme-color" content="#fbfbfd" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <!-- Hreflang -->
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="TypeWhisper" />
    <meta property="og:locale" content={ogLocale(locale)} />
    <meta property="og:locale:alternate" content={ogLocale(locale === "de" ? "en" : "de")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Type_Whisper" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {structuredData && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    {import.meta.env.PROD && (
      <script is:inline async src="https://analytics.typewhisper.com/js/pa-ThTV9i2sjGtEO8URGyt6T.js"></script>
    )}
    {import.meta.env.PROD && (
      <script is:inline>
        window.plausible = window.plausible || function() {
          (window.plausible.q = window.plausible.q || []).push(arguments);
        };
        window.plausible.init = window.plausible.init || function(options) {
          window.plausible.o = options || {};
        };
        window.plausible.init({
          formSubmissions: false,
          fileDownloads: false,
          outboundLinks: false,
        });
      </script>
    )}
    <script is:inline id="page-translations" type="application/json" set:html={JSON.stringify(getClientMessages(locale, Astro.url.pathname)).replace(/</g, "\\u003c")} />
    <!-- Theme init (prevent flash) -->
    <script is:inline>
      (function(){
        var stored = localStorage.getItem('theme');
        var theme = stored === 'light' || stored === 'dark' ? stored
          : window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.classList.add(theme);
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-background focus:p-3">{locale === "de" ? "Zum Inhalt" : "Skip to content"}</a>
    <div class="flex min-h-screen flex-col">
      <Header client:load currentPath={Astro.url.pathname} locale={locale} />
      <main id="main-content" class="min-w-0 flex-1" data-pagefind-body>
        {searchPlatforms.map(platform => <span hidden data-pagefind-filter={`platform:${platform}`} />)}
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
    <DownloadSocialBanner locale={locale} />
    <!-- Scroll reveal (vanilla JS, replaces React useScrollReveal hook) -->
    <script is:inline>
      (function(){
        var revealClasses = [
          { hidden: 'reveal-hidden', visible: 'reveal-visible' },
          { hidden: 'reveal-fade-hidden', visible: 'reveal-fade-visible' },
          { hidden: 'reveal-scale-hidden', visible: 'reveal-scale-visible' },
        ];
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              for (var i = 0; i < revealClasses.length; i++) {
                if (entry.target.classList.contains(revealClasses[i].hidden)) {
                  entry.target.classList.add(revealClasses[i].visible);
                  entry.target.classList.remove(revealClasses[i].hidden);
                  break;
                }
              }
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
        var selector = revealClasses.map(function(c) { return '.' + c.hidden; }).join(', ');

        function observeRevealElements(root) {
          if (root.matches && root.matches(selector)) observer.observe(root);
          root.querySelectorAll(selector).forEach(function(el) { observer.observe(el); });
        }

        document.querySelectorAll(selector).forEach(function(el) {
          if (!el.closest('astro-island')) observer.observe(el);
        });

        document.querySelectorAll('astro-island').forEach(function(island) {
          if (island.hasAttribute('ssr')) {
            island.addEventListener('astro:hydrate', function() {
              setTimeout(function() {
                observeRevealElements(island);
              }, 100);
            }, { once: true });
          } else {
            observeRevealElements(island);
          }
        });
      })();
    </script>
    <script>
      import { initializeAttributionTracking } from "@/lib/attribution";

      initializeAttributionTracking();
    </script>
  </body>
</html>
