---
import { ArrowRight } from "lucide-react";
import { BarMark } from "@/components/site";
import { MacOSLogo, WindowsLogo, IOSLogo } from "@/components/ui/platform-logos";
import AddonHostRequirement from "@/components/addons/addon-host-requirement.astro";
import { shotSize } from "@/components/addons/shot-size";
import { addonShotText } from "@/components/addons/shot-text";
import {
  editionPlatformSlugs,
  getDefaultAddonEditionScreenshot,
  type AddonEdition,
  type AddonEditionScreenshot,
} from "@/data/addon-editions";
import { platformKeys, type PluginPlatform } from "@/data/addons";
import { screenshotPath, t, webpPath, type Locale } from "@/i18n/index";

interface Props {
  edition: AddonEdition;
  /** Name of the add-on family, for the text of the preview. */
  name: string;
  familyPath: string;
  locale: Locale;
}

const { edition, name, familyPath, locale } = Astro.props;
const platformIcons: Record<PluginPlatform, typeof MacOSLogo> = {
  mac: MacOSLogo,
  windows: WindowsLogo,
  ios: IOSLogo,
};
const Icon = platformIcons[edition.platform];
const platformLabel = t(locale, platformKeys[edition.platform]);

// One real capture per edition, left out when the edition has none.
const screenshot: AddonEditionScreenshot | undefined =
  edition.screenshots?.[0] ?? getDefaultAddonEditionScreenshot(edition);
const previewSrc = screenshot
  ? screenshot.localized === false
    ? screenshot.src
    : screenshotPath(locale, screenshot.src)
  : undefined;
const previewSize = previewSrc ? await shotSize(previewSrc) : undefined;
const previewAlt = addonShotText(locale, {
  name,
  platform: edition.platform,
  alt: screenshot?.alt,
}).alt;
---

<li
  class="addon-edition"
  data-testid="addon-edition-card"
  data-platform={edition.platform}
>
  <div class="addon-edition__head">
    <Icon className="addon-edition__icon" aria-hidden="true" />
    <h3 class="site-heading">{platformLabel}</h3>
    <span class="addon-edition__version">v{edition.version}</span>
  </div>

  {previewSrc && previewSize && (
    <figure class="addon-edition__preview">
      <picture>
        <source srcset={webpPath(previewSrc)} type="image/webp" />
        <img
          src={previewSrc}
          alt={previewAlt}
          width={previewSize.width}
          height={previewSize.height}
          loading="lazy"
          decoding="async"
        />
      </picture>
    </figure>
  )}

  <p class="site-text">{edition.description}</p>
  <AddonHostRequirement platform={edition.platform} minAppVersion={edition.minAppVersion} locale={locale} />

  {edition.highlights && edition.highlights.length > 0 && (
    <ul class="site-list" aria-label={t(locale, "addons.editions.highlights")}>
      {edition.highlights.slice(0, 4).map((highlight) => (
        <li>
          <BarMark />
          <span>{highlight}</span>
        </li>
      ))}
    </ul>
  )}

  <a
    href={`${familyPath}${editionPlatformSlugs[edition.platform]}/`}
    class="site-link addon-edition__link"
  >
    <span>{t(locale, "addons.editions.openEdition")}<span class="sr-only">: {platformLabel}</span></span>
    <ArrowRight className="size-4" aria-hidden="true" />
  </a>
</li>
