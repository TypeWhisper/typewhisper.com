---
import { discordUrl, orgGitHubUrl } from "@/lib/platform-download";
import { t, type Locale } from "@/i18n/index";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const xFollowUrl = "https://x.com/intent/follow?screen_name=Type_Whisper";
const shareUrl = `https://www.typewhisper.com/${locale}/`;
const shareTitle =
  locale === "de"
    ? "TypeWhisper - lokale Sprache-zu-Text Workflows"
    : "TypeWhisper - local speech-to-text workflows";
const redditShareUrl = `https://www.reddit.com/submit?url=${encodeURIComponent(shareUrl)}&title=${encodeURIComponent(shareTitle)}`;
const socialLinks = [
  { href: xFollowUrl, label: t(locale, "downloadSocial.x"), icon: "x" },
  { href: redditShareUrl, label: t(locale, "downloadSocial.reddit"), icon: "reddit" },
  { href: discordUrl, label: t(locale, "downloadSocial.discord"), icon: "discord" },
  { href: orgGitHubUrl, label: t(locale, "downloadSocial.github"), icon: "github" },
];
---

<div
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/55 p-4 backdrop-blur-sm"
  data-download-social-banner-root
  data-testid="download-social-banner"
>
  <aside
    role="dialog"
    aria-modal="true"
    aria-live="polite"
    aria-labelledby="download-social-title"
    class="w-full max-w-md rounded-xl border border-border bg-popover p-5 text-popover-foreground shadow-2xl sm:p-6"
    data-download-social-dialog
  >
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">
          {t(locale, "downloadSocial.kicker")}
        </p>
        <h2 id="download-social-title" class="mt-1 text-xl font-semibold">
          {t(locale, "downloadSocial.title")}
        </h2>
        <p class="mt-1 text-sm leading-5 text-muted-foreground">
          {t(locale, "downloadSocial.description")}
        </p>
      </div>
      <button
        type="button"
        class="-mr-2 -mt-2 inline-flex size-8 shrink-0 items-center justify-center rounded-md text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        aria-label={t(locale, "downloadSocial.close")}
        data-download-social-close
      >
        <span aria-hidden="true">x</span>
      </button>
    </div>

    <div class="mt-5 grid grid-cols-2 gap-2">
      {socialLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-10 items-center justify-center gap-2 rounded-md border border-border bg-background px-3 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >
          <span class="inline-flex size-4 items-center justify-center" aria-hidden="true" data-social-icon={link.icon}>
            {link.icon === "x" && (
              <svg viewBox="0 0 24 24" class="size-4 fill-current">
                <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.847h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.153h7.594l5.243 6.932 6.064-6.932Zm-1.291 19.492h2.039L6.486 3.24H4.298L17.61 20.645Z" />
              </svg>
            )}
            {link.icon === "reddit" && (
              <svg viewBox="0 0 24 24" class="size-4 fill-current">
                <path d="M12 1.5a10.5 10.5 0 1 0 0 21 10.5 10.5 0 0 0 0-21Zm4.98 5.23c.7 0 1.27.57 1.27 1.27 0 .33-.13.63-.34.86.9.69 1.47 1.63 1.47 2.67 0 2.42-3.31 4.38-7.38 4.38s-7.38-1.96-7.38-4.38c0-1.05.58-2 1.5-2.69a1.27 1.27 0 1 1 1.4-2.09 9.43 9.43 0 0 1 3.76-.9l.71-3.34a.42.42 0 0 1 .5-.32l2.37.5a1.27 1.27 0 0 1 1.12-.66Zm-7.7 4.02a1.05 1.05 0 1 0 0 2.1 1.05 1.05 0 0 0 0-2.1Zm5.44 0a1.05 1.05 0 1 0 0 2.1 1.05 1.05 0 0 0 0-2.1Zm-6.06 3.35a.47.47 0 0 0-.35.79c.78.78 2.07 1.16 3.69 1.16s2.91-.38 3.69-1.16a.47.47 0 1 0-.67-.67c-.58.58-1.61.88-3.02.88s-2.44-.3-3.02-.88a.47.47 0 0 0-.32-.12Z" />
              </svg>
            )}
            {link.icon === "discord" && (
              <svg viewBox="0 0 24 24" class="size-4 fill-current">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.194.372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03ZM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418Zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418Z" />
              </svg>
            )}
            {link.icon === "github" && (
              <svg viewBox="0 0 24 24" class="size-4 fill-current">
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12Z" />
              </svg>
            )}
          </span>
          <span class="truncate">{link.label}</span>
        </a>
      ))}
    </div>
  </aside>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-download-social-banner-root]");
    if (!root) return;

    let hideTimer;

    function hideBanner() {
      root.classList.add("hidden");
      root.classList.remove("flex");
      if (hideTimer) {
        window.clearTimeout(hideTimer);
        hideTimer = undefined;
      }
    }

    function showBanner(event) {
      if (!(event.target instanceof Element)) return;
      if (!event.target.closest("[data-download-social-trigger]")) return;

      root.classList.remove("hidden");
      root.classList.add("flex");
      root.querySelector("[data-download-social-close]")?.focus();

      if (hideTimer) {
        window.clearTimeout(hideTimer);
      }
      hideTimer = window.setTimeout(hideBanner, 14000);
    }

    document.addEventListener("click", showBanner);
    root.addEventListener("click", (event) => {
      if (event.target === root) {
        hideBanner();
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !root.classList.contains("hidden")) {
        hideBanner();
      }
    });
    root
      .querySelector("[data-download-social-close]")
      ?.addEventListener("click", hideBanner);
  })();
</script>
