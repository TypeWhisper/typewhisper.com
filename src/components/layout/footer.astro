---
import { Logo } from "@/components/ui/logo";
import { Waveform } from "@/components/ui/waveform";
import { discordUrl } from "@/lib/platform-download";
import type { Locale } from "@/i18n/index";
import { t, localePath } from "@/i18n/index";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
---

<footer class="border-t border-border bg-card text-card-foreground">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="mb-8 flex justify-center" aria-hidden="true">
      <Waveform bars={56} className="h-5 w-full max-w-sm opacity-50" />
    </div>
    <div class="flex flex-col gap-6">
      <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between">
        <Logo />
        <div class="flex flex-col items-start gap-2 sm:items-end">
          <p class="text-sm text-muted-foreground">
            {t(locale, "footer.tagline")}
          </p>
          <span
            class="inline-flex items-center gap-2 rounded-full border border-border/70 bg-background/60 px-3 py-1 text-xs font-medium text-muted-foreground"
            title={t(locale, "madeInGermany.craft")}
          >
            <img
              src="/flags/de.svg"
              alt=""
              aria-hidden="true"
              class="h-3 w-auto rounded-[2px]"
            />
            {t(locale, "madeInGermany.label")}
          </span>
        </div>
      </div>

      <div class="h-px bg-border"></div>

      <div class="flex flex-col gap-4 text-xs text-muted-foreground sm:flex-row sm:items-start sm:justify-between">
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          <a href={localePath(locale, "/#features")} class="transition-colors hover:text-foreground">{t(locale, "footer.features")}</a>
          <a href={localePath(locale, "/pricing")} class="transition-colors hover:text-foreground">{t(locale, "footer.pricing")}</a>
          <a href={localePath(locale, "/business")} class="transition-colors hover:text-foreground">{t(locale, "footer.business")}</a>
          <a href={localePath(locale, "/sponsors")} class="transition-colors hover:text-foreground">{t(locale, "footer.sponsors")}</a>
          <a href={localePath(locale, "/addons")} class="transition-colors hover:text-foreground">{t(locale, "footer.addons")}</a>
          <a href={localePath(locale, "/docs")} class="transition-colors hover:text-foreground">{t(locale, "footer.docs")}</a>
          <a href={localePath(locale, "/release-status")} class="transition-colors hover:text-foreground">{t(locale, "footer.releaseStatus")}</a>
          <a href={localePath(locale, "/support")} class="transition-colors hover:text-foreground">{t(locale, "footer.support")}</a>
          <a href={localePath(locale, "/changelog")} class="transition-colors hover:text-foreground">{t(locale, "footer.changelog")}</a>
          <a href="https://github.com/TypeWhisper/typewhisper-win/releases" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-foreground">{t(locale, "footer.windowsBeta")}</a>
          <a href="https://testflight.apple.com/join/kcCS3hcZ" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-foreground">{t(locale, "footer.iosAlpha")}</a>
        </div>
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          <a href={discordUrl} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-foreground">{t(locale, "footer.discord")}</a>
          <a href="https://github.com/TypeWhisper" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-foreground">{t(locale, "footer.github")}</a>
          <a href="https://ko-fi.com/seofood" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-foreground">{t(locale, "footer.kofi")}</a>
        </div>
      </div>

      <div class="h-px bg-border"></div>

      <div class="flex flex-col items-start gap-3 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
        <p>&copy; {new Date().getFullYear()} {t(locale, "footer.copyright")}</p>
        <div class="flex gap-x-6 gap-y-2 flex-wrap">
          <a href={localePath(locale, "/privacy")} class="transition-colors hover:text-foreground">{t(locale, "footer.privacy")}</a>
          <a href={localePath(locale, "/terms")} class="transition-colors hover:text-foreground">{t(locale, "footer.terms")}</a>
          <a href={localePath(locale, "/legal-notice")} class="transition-colors hover:text-foreground">{t(locale, "footer.legalNotice")}</a>
        </div>
      </div>
    </div>
  </div>
</footer>
