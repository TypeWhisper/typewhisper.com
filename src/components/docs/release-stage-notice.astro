---
import { t, type Locale } from "@/i18n/index";

interface Props {
  stage: "stable" | "beta" | "alpha" | "pending";
  title: string;
  description: string;
  locale?: Locale;
}

const { stage, title, description, locale = "en" } = Astro.props;
---

<div class="docs-callout docs-callout--release" role="note">
  <p class="docs-callout__label">{t(locale, `releaseStage.${stage}`)}</p>
  <p>
    <strong class="docs-callout__title">{title}</strong>
    {" "}
    {description}
  </p>
</div>
