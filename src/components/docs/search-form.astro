---
import { t, type Locale } from "@/i18n/index";
import { Search } from "lucide-react";

const { locale, platform } = Astro.props as {
  locale: Locale;
  platform?: string;
};
const id = `docs-query-${platform ?? "all"}`;
---

<form action={`/${locale}/docs/search/`} class="docs-search" role="search">
  <label class="sr-only" for={id}>{t(locale, "docs.search.label")}</label>
  <Search aria-hidden="true" />
  <input
    id={id}
    name="q"
    type="search"
    required
    autocomplete="off"
    placeholder={t(locale, "docs.search.label")}
    class="docs-search__input"
    aria-keyshortcuts="/"
    data-docs-search-input
  />
  {platform && <input type="hidden" name="platform" value={platform} />}
  <kbd class="docs-search__key" title={t(locale, "docs.searchShortcut")}>/</kbd>
  <button class="docs-search__submit">{t(locale, "docs.search.submit")}</button>
</form>
