---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "@/i18n/index";
import ChangelogPage from "../../changelog/_index.tsx";

const locale = "en";
---

<BaseLayout
  title={t(locale, "changelog.title")}
  description={t(locale, "changelog.description")}
  canonicalPath="/en/changelog"
  locale={locale}
>
  <ChangelogPage client:load />
</BaseLayout>
