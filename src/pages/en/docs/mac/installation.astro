---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsMacInstallation from "@/pages/docs/mac/_installation.tsx";
import { t } from "@/i18n/index";

const locale = "en";
---
<DocsLayout
  title={t(locale, "docs.mac.installation.meta.title")}
  description={t(locale, "docs.mac.installation.meta.description")}
  canonicalPath="/en/docs/mac/installation"
  locale={locale}
  platform="mac"
>
  <DocsMacInstallation locale={locale} client:load />
</DocsLayout>
