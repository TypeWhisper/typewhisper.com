---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t, localePath } from "@/i18n/index";
import { Button } from "@/components/ui/button";
import { commercialTiers, currencySymbol, salesEmail } from "@/lib/pricing";
import { macReleaseUrl } from "@/lib/platform-download";

const locale = "en";

const teamTier = commercialTiers.find((t) => t.id === "team");
const enterpriseTier = commercialTiers.find((t) => t.id === "enterprise");

const features = [
  { key: "deviceManagement", icon: "devices" },
  { key: "adminProfiles", icon: "profiles" },
  { key: "customEngines", icon: "engines" },
  { key: "compliance", icon: "compliance" },
  { key: "prioritySupport", icon: "support" },
  { key: "auditable", icon: "auditable" },
];

const trust = ["local", "gpl", "noTelemetry"];
---

<BaseLayout
  title={t(locale, "business.meta.title")}
  description={t(locale, "business.meta.description")}
  canonicalPath="/en/business"
  locale={locale}
>
  <section class="relative overflow-hidden py-16 sm:py-24">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -left-32 top-0 h-[400px] w-[400px] rounded-full bg-indigo-400/10 blur-[120px] dark:bg-indigo-500/15"></div>
      <div class="absolute -right-32 top-32 h-[400px] w-[400px] rounded-full bg-sky-400/10 blur-[120px] dark:bg-sky-500/15"></div>
    </div>

    <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6">
      <span class="inline-flex items-center gap-2 rounded-full border border-border/60 bg-background/60 px-3 py-1 text-xs font-medium text-muted-foreground backdrop-blur-sm">
        {t(locale, "business.hero.badge")}
      </span>
      <h1 class="mt-6 font-display text-4xl font-bold tracking-tighter sm:text-5xl lg:text-6xl">
        {t(locale, "business.hero.title")}
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-muted-foreground">
        {t(locale, "business.hero.subtitle")}
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button size="pill" asChild>
          <a href={`mailto:${salesEmail}`}>{t(locale, "business.hero.ctaSales")}</a>
        </Button>
        <Button variant="outline" size="pill" asChild>
          <a href={localePath(locale, "/pricing")}>{t(locale, "business.hero.ctaPricing")}</a>
        </Button>
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
          {t(locale, "business.features.title")}
        </h2>
        <p class="mt-3 text-muted-foreground">
          {t(locale, "business.features.subtitle")}
        </p>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {features.map(({ key }) => (
          <div class="rounded-2xl border bg-card p-6">
            <h3 class="text-base font-semibold">{t(locale, `business.feature.${key}.title`)}</h3>
            <p class="mt-2 text-sm text-muted-foreground">{t(locale, `business.feature.${key}.description`)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="rounded-3xl border bg-card p-8 sm:p-12">
        <div class="grid gap-8 md:grid-cols-2 md:items-center">
          <div>
            <h2 class="font-display text-3xl font-bold tracking-tight">
              {t(locale, "business.trust.title")}
            </h2>
            <p class="mt-3 text-muted-foreground">
              {t(locale, "business.trust.subtitle")}
            </p>
          </div>
          <ul class="space-y-3 text-sm">
            {trust.map((key) => (
              <li class="flex gap-3">
                <span class="mt-1 size-2 shrink-0 rounded-full bg-emerald-500"></span>
                <div>
                  <p class="font-medium text-foreground">{t(locale, `business.trust.${key}.title`)}</p>
                  <p class="text-muted-foreground">{t(locale, `business.trust.${key}.description`)}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
          {t(locale, "business.pricing.title")}
        </h2>
        <p class="mt-3 text-muted-foreground">
          {t(locale, "business.pricing.subtitle")}
        </p>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {teamTier && (
          <div class="rounded-2xl border bg-card p-6">
            <p class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">
              {t(locale, "pricing.tiers.team.name")}
            </p>
            <p class="mt-2 text-3xl font-bold">
              {teamTier.price.monthly} {currencySymbol}
              <span class="ml-1 text-base font-normal text-muted-foreground">
                {t(locale, "pricing.tiers.perMonth")}
              </span>
            </p>
            <p class="mt-1 text-sm text-muted-foreground">
              {t(locale, "business.pricing.teamDevices")}
            </p>
            <Button asChild className="mt-4 w-full" variant="outline">
              <a href={teamTier.checkout.monthly} target="_blank" rel="noopener noreferrer">
                {t(locale, "business.pricing.startTeam")}
              </a>
            </Button>
          </div>
        )}
        {enterpriseTier && (
          <div class="rounded-2xl border border-primary/40 bg-card p-6">
            <p class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">
              {t(locale, "pricing.tiers.enterprise.name")}
            </p>
            <p class="mt-2 text-3xl font-bold">
              {enterpriseTier.price.monthly} {currencySymbol}
              <span class="ml-1 text-base font-normal text-muted-foreground">
                {t(locale, "pricing.tiers.perMonth")}
              </span>
            </p>
            <p class="mt-1 text-sm text-muted-foreground">
              {t(locale, "business.pricing.enterpriseDevices")}
            </p>
            <Button asChild className="mt-4 w-full">
              <a href={`mailto:${salesEmail}`}>
                {t(locale, "business.pricing.contactSales")}
              </a>
            </Button>
          </div>
        )}
      </div>

      <p class="mt-6 text-center text-sm text-muted-foreground">
        <a href={localePath(locale, "/pricing")} class="text-primary underline-offset-4 hover:underline">
          {t(locale, "business.pricing.seeAll")}
        </a>
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
      <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
        {t(locale, "business.finalCta.title")}
      </h2>
      <p class="mt-3 text-muted-foreground">
        {t(locale, "business.finalCta.subtitle")}
      </p>
      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button size="pill" asChild>
          <a href={macReleaseUrl} target="_blank" rel="noopener noreferrer">
            {t(locale, "business.finalCta.download")}
          </a>
        </Button>
        <Button variant="outline" size="pill" asChild>
          <a href={`mailto:${salesEmail}`}>{t(locale, "business.finalCta.contact")}</a>
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
