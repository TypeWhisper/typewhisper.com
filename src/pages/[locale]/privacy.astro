---
import "@/styles/utility.css";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageHead } from "@/components/site";
import { t, localePath, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;

const securityReviewHref = localePath(locale, "/business/legal-security-review");

type PrivacySection =
  | { id: "overview" | "dataCollection" | "analytics" | "premiumSync" | "contributions" | "network" | "thirdParty" | "openSource" | "contact"; kind: "simple" }
  | { id: "localStorage"; kind: "list" }
  | { id: "securityReview"; kind: "link" };

const sections: PrivacySection[] = [
  { id: "overview", kind: "simple" },
  { id: "dataCollection", kind: "simple" },
  { id: "analytics", kind: "simple" },
  { id: "localStorage", kind: "list" },
  { id: "premiumSync", kind: "simple" },
  { id: "contributions", kind: "simple" },
  { id: "network", kind: "simple" },
  { id: "thirdParty", kind: "simple" },
  { id: "securityReview", kind: "link" },
  { id: "openSource", kind: "simple" },
  { id: "contact", kind: "simple" },
];
---

<BaseLayout
  title={t(locale, "privacy.meta.title")}
  description={t(locale, "privacy.meta.description")}
  canonicalPath={canonicalPath(locale, "/privacy")}
  locale={locale}
>
  <div class="site-page">
    <PageHead
      compact
      wrap="prose"
      label={t(locale, "legal.label")}
      title={t(locale, "privacy.heading")}
      meta={t(locale, "privacy.updated")}
    />
    <section class="site-section site-section--tight-top">
      <div class="site-wrap site-wrap--prose">
        <nav class="utility-toc" aria-labelledby="privacy-contents" data-testid="privacy-toc">
          <p class="site-label site-label--muted" id="privacy-contents">{t(locale, "legal.contents")}</p>
          <ol class="utility-toc__list">
            {sections.map((section) => (
              <li>
                <a href={`#${section.id}`}>{t(locale, `privacy.section.${section.id}.title`)}</a>
              </li>
            ))}
          </ol>
        </nav>

        <div class="site-prose utility-reading">
          {sections.map((section) => (
            <>
              <h2 id={section.id}>{t(locale, `privacy.section.${section.id}.title`)}</h2>

              {section.kind === "simple" && (
                <p set:html={t(locale, `privacy.section.${section.id}.p1`)} />
              )}

              {section.kind === "list" && (
                <>
                  <p>{t(locale, "privacy.section.localStorage.p1")}</p>
                  <ul>
                    <li>{t(locale, "privacy.section.localStorage.item1")}</li>
                    <li>{t(locale, "privacy.section.localStorage.item2")}</li>
                    <li>{t(locale, "privacy.section.localStorage.item3")}</li>
                  </ul>
                  <p>{t(locale, "privacy.section.localStorage.p2")}</p>
                </>
              )}

              {section.kind === "link" && (
                <p>
                  {t(locale, "privacy.section.securityReview.beforeLink")}
                  <a href={securityReviewHref}>
                    {t(locale, "privacy.section.securityReview.linkText")}
                  </a>.
                </p>
              )}
            </>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
