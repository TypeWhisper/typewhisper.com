---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t, localePath, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;

const securityReviewHref = localePath(locale, "/business/legal-security-review");

type PrivacySection =
  | { id: "overview" | "dataCollection" | "network" | "thirdParty" | "openSource" | "contact"; kind: "simple" }
  | { id: "localStorage"; kind: "list" }
  | { id: "securityReview"; kind: "link" };

const sections: PrivacySection[] = [
  { id: "overview", kind: "simple" },
  { id: "dataCollection", kind: "simple" },
  { id: "localStorage", kind: "list" },
  { id: "network", kind: "simple" },
  { id: "thirdParty", kind: "simple" },
  { id: "securityReview", kind: "link" },
  { id: "openSource", kind: "simple" },
  { id: "contact", kind: "simple" },
];
---

<BaseLayout
  title={t(locale, "privacy.meta.title")}
  description={t(locale, "privacy.meta.description")}
  canonicalPath={canonicalPath(locale, "/privacy")}
  locale={locale}
>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:py-16">
    <h1 class="font-display text-3xl font-bold tracking-tight">{t(locale, "privacy.heading")}</h1>
    <p class="mt-2 text-sm text-muted-foreground">{t(locale, "privacy.updated")}</p>
    <div class="mt-8 space-y-6 text-sm leading-relaxed text-muted-foreground">
      {sections.map((section) => (
        <section>
          <h2 class="text-lg font-semibold text-foreground">
            {t(locale, `privacy.section.${section.id}.title`)}
          </h2>

          {section.kind === "simple" && (
            <p class="mt-2" set:html={t(locale, `privacy.section.${section.id}.p1`)} />
          )}

          {section.kind === "list" && (
            <>
              <p class="mt-2">{t(locale, "privacy.section.localStorage.p1")}</p>
              <ul class="mt-2 list-disc space-y-1 pl-5">
                <li>{t(locale, "privacy.section.localStorage.item1")}</li>
                <li>{t(locale, "privacy.section.localStorage.item2")}</li>
                <li>{t(locale, "privacy.section.localStorage.item3")}</li>
              </ul>
              <p class="mt-2">{t(locale, "privacy.section.localStorage.p2")}</p>
            </>
          )}

          {section.kind === "link" && (
            <p class="mt-2">
              {t(locale, "privacy.section.securityReview.beforeLink")}
              <a href={securityReviewHref} class="text-primary hover:underline">
                {t(locale, "privacy.section.securityReview.linkText")}
              </a>.
            </p>
          )}
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
