---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getUseCaseModules, getUseCases } from "@/data/use-cases";
import { UseCaseHero } from "@/components/use-cases/use-case-hero";
import { UseCaseFeatures } from "@/components/use-cases/use-case-features";
import { UseCaseHowItWorks } from "@/components/use-cases/use-case-how-it-works";
import { UseCaseBenefits } from "@/components/use-cases/use-case-benefits";
import { UseCaseRelated } from "@/components/use-cases/use-case-related";
import { UseCaseCTA } from "@/components/use-cases/use-case-cta";
import { locales } from "@/i18n/index";
import { canonicalPath } from "@/lib/locale-routes";

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    getUseCaseModules(locale).map((mod) => ({
      params: { locale, slug: mod.frontmatter.slug },
      props: { locale, mod },
    })),
  );
}

const { locale, mod } = Astro.props;
const useCase = mod.frontmatter;
const Content = mod.default;
const allUseCases = getUseCases(locale);
const basePath = canonicalPath(locale, "/use-cases");
---
<BaseLayout
  title={`${useCase.name} - TypeWhisper`}
  description={useCase.description}
  canonicalPath={canonicalPath(locale, `/use-cases/${useCase.slug}`)}
  locale={locale}
>
  <UseCaseHero useCase={useCase} backHref={basePath} locale={locale} />
  <UseCaseFeatures features={useCase.features} locale={locale} color={useCase.color} />
  <UseCaseHowItWorks steps={useCase.howItWorks} locale={locale} color={useCase.color} />
  <UseCaseBenefits benefits={useCase.benefits} locale={locale} color={useCase.color} />
  {Content && (
    <section class="section-light py-16 sm:py-20">
      <div class="prose prose-neutral mx-auto max-w-4xl px-4 sm:px-6 prose-headings:text-foreground prose-p:text-muted-foreground prose-li:text-muted-foreground prose-strong:text-foreground prose-a:text-primary">
        <Content />
      </div>
    </section>
  )}
  <UseCaseRelated
    currentSlug={useCase.slug}
    allUseCases={allUseCases}
    basePath={basePath}
    locale={locale}
  />
  <UseCaseCTA locale={locale} color={useCase.color} />
</BaseLayout>
