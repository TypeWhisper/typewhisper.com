---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/use-cases.css";
import UseCasesIndex from "@/pages/use-cases/_index.tsx";
import { getUseCases } from "@/data/use-cases";
import { t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const entries = getUseCases(locale).map(
  ({ slug, name, description, category, group }) => ({
    slug,
    name,
    description,
    category,
    group,
  }),
);
const basePath = canonicalPath(locale, "/use-cases");
---
<BaseLayout
  title={t(locale, "useCases.title")}
  description={t(locale, "useCases.description")}
  canonicalPath={basePath}
  locale={locale}
>
  <UseCasesIndex client:load locale={locale} entries={entries} basePath={basePath} />
</BaseLayout>
