---
import "@/styles/utility.css";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ArrowRight, ArrowUpRight } from "lucide-react";
import { BarMark, PageHead, WaveRule } from "@/components/site";
import { localePath, t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";
import { androidBetaProgram } from "@/lib/android";
import {
  androidVersion,
  discordUrl,
  getAndroidPlayStoreUrl,
} from "@/lib/platform-download";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;

const feedback = [
  {
    label: t(locale, "android.beta.discord"),
    text: t(locale, "android.beta.discordText"),
    href: discordUrl,
  },
  {
    label: androidBetaProgram.feedbackEmail,
    text: t(locale, "android.beta.emailText"),
    href: `mailto:${androidBetaProgram.feedbackEmail}`,
  },
];
---

<BaseLayout
  title={t(locale, "android.meta.title")}
  description={t(locale, "android.meta.description")}
  canonicalPath={canonicalPath(locale, "/android")}
  locale={locale}
>
  <div class="site-page">
    <PageHead
      label={t(locale, "android.label")}
      title={t(locale, "android.title")}
      lede={t(locale, "android.lede")}
      meta={t(locale, "android.requirement")}
    />

    <section class="site-section site-section--tight-top" data-testid="android-get">
      <div class="site-wrap">
        <WaveRule label={t(locale, "android.get.label")} seed={5} />
        <div class="site-split">
          <div class="site-split__head">
            <h2 class="site-title site-title--start">{t(locale, "android.get.title")}</h2>
            <p class="site-lede site-lede--start">{t(locale, "android.get.lede")}</p>
          </div>
          <div class="site-actions site-actions--start">
            <a
              href={getAndroidPlayStoreUrl(locale)}
              class="site-button"
              target="_blank"
              rel="noopener noreferrer"
              data-testid="android-play"
              data-download-social-trigger
              data-download-platform="android"
              data-download-target="android_play_store"
              data-download-version={androidVersion}
              data-tracking-placement="landing"
            >
              {t(locale, "android.get.button")}
              <ArrowUpRight className="size-4" aria-hidden="true" />
            </a>
            <a href={localePath(locale, "/docs/android")} class="site-link">
              {t(locale, "android.get.docs")}
              <ArrowRight className="size-4" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="site-section site-section--band">
      <div class="site-wrap">
        <WaveRule label={t(locale, "android.features.label")} seed={9} />
        <div class="site-split">
          <div class="site-split__head">
            <h2 class="site-title site-title--start">{t(locale, "android.features.title")}</h2>
            <p class="site-lede site-lede--start">{t(locale, "android.features.lede")}</p>
          </div>
          <ul class="site-points">
            {[1, 2, 3, 4, 5, 6, 7, 8].map((item) => (
              <li class="site-points__item">
                <BarMark className="site-points__mark utility-point__mark" />
                <p class="utility-point">{t(locale, `android.features.item${item}`)}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="site-section" data-testid="android-beta-program">
      <div class="site-wrap">
        <WaveRule label={t(locale, "android.beta.label")} seed={13} />
        <div class="site-split">
          <div class="site-split__head">
            <h2 class="site-title site-title--start">{t(locale, "android.beta.title")}</h2>
            <p class="site-text">{t(locale, "android.beta.p1")}</p>
            <p class="site-text">{t(locale, "android.beta.p2")}</p>
            <div class="site-actions site-actions--start">
              <a
                href={androidBetaProgram.optInUrl}
                class="site-button site-button--small"
                target="_blank"
                rel="noopener noreferrer"
                data-testid="android-beta-optin"
              >
                {t(locale, "android.beta.button")}
                <ArrowUpRight className="size-4" aria-hidden="true" />
              </a>
            </div>
            <p class="site-text">{t(locale, "android.beta.p3")}</p>
          </div>
          <div>
            <ul class="utility-rows">
              {feedback.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="utility-rows__link"
                    target={link.href.startsWith("mailto:") ? undefined : "_blank"}
                    rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
                  >
                    <span class="utility-rows__name">{link.label}</span>
                    <span class="utility-rows__text">{link.text}</span>
                    <ArrowUpRight className="size-5" aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ul>
            <h3 class="site-heading utility-after-rows">{t(locale, "android.requirements.title")}</h3>
            <p class="site-text">{t(locale, "android.requirements.text")}</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
