---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AddonEditionGuide from "@/components/addons/addon-edition-guide.astro";
import AddonEditionSwitcher from "@/components/addons/addon-edition-switcher.astro";
import { Badge } from "@/components/ui/badge";
import { BrandLogo, canRenderBrandLogo } from "@/components/ui/brand-logo";
import {
  addonEditionHasGuide,
  editionPlatformSlugs,
  getDefaultAddonEditionScreenshot,
  getAddonEditionModules,
  getAddonEditions,
} from "@/data/addon-editions";
import {
  getPlugin,
  getPluginModule,
  platformKeys,
  sourceKeys,
  type Plugin,
  type PluginPlatform,
} from "@/data/addons";
import { locales, screenshotPath, t, webpPath, type Locale } from "@/i18n/index";
import { canonicalPath } from "@/lib/locale-routes";
import {
  ArrowLeft,
  Check,
  ExternalLink,
  Gem,
  Plug,
  SlidersHorizontal,
} from "lucide-react";

interface Props {
  locale: Locale;
  plugin: Plugin;
  platform: PluginPlatform;
}

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    getAddonEditionModules(locale).flatMap((mod) => {
      const edition = mod.frontmatter;
      const plugin = getPlugin(edition.familySlug, locale);

      if (!plugin) {
        return [];
      }

      return [{
        params: {
          locale,
          slug: edition.familySlug,
          platform: editionPlatformSlugs[edition.platform],
        },
        props: { locale, plugin, platform: edition.platform },
      }];
    }),
  );
}

const { locale, plugin, platform } = Astro.props;
const editions = getAddonEditions(plugin.slug, locale);
const editionModule = getAddonEditionModules(locale).find(
  (mod) =>
    mod.frontmatter.familySlug === plugin.slug &&
    mod.frontmatter.platform === platform,
);

if (!editionModule) {
  throw new Error(`Missing ${platform} edition for ${plugin.slug} (${locale})`);
}

const edition = editionModule.frontmatter;
const editionHasGuide = addonEditionHasGuide(plugin.slug, platform, locale);
const familyModule = platform === "mac"
  ? getPluginModule(plugin.slug, locale)
  : undefined;
const GuideContent = editionHasGuide
  ? editionModule.default
  : familyModule?.default;
const platformLabel = t(locale, platformKeys[platform]);
const familyPath = canonicalPath(locale, `/addons/${plugin.slug}`);
const editionPath = `${familyPath}/${editionPlatformSlugs[platform]}`;
const pageTitle = `${plugin.name} ${t(locale, "addons.editions.for")} ${platformLabel}`;
const showBrandLogo = plugin.brandLogo
  ? canRenderBrandLogo(plugin.brandLogo, "addon")
  : false;
const configuredScreenshots = edition.screenshots ?? [];
const defaultScreenshot = getDefaultAddonEditionScreenshot(edition);
const editionScreenshots = configuredScreenshots.length > 0
  ? configuredScreenshots
  : defaultScreenshot
    ? [{
        ...defaultScreenshot,
        alt: `${plugin.name} ${platformLabel} ${t(locale, "addons.settingsAlt")}`,
      }]
    : [];
const screenshots = editionScreenshots.map((screenshot) => {
  const localizedSrc = screenshot.localized === false
    ? screenshot.src
    : screenshotPath(locale, screenshot.src);
  return {
    ...screenshot,
    src: localizedSrc,
    webpSrc: webpPath(localizedSrc),
  };
});
---

<BaseLayout
  title={`${pageTitle} - TypeWhisper Add-ons`}
  description={edition.description}
  canonicalPath={editionPath}
  locale={locale}
>
  <div class="py-12 sm:py-16 lg:py-20" data-testid="addon-edition-detail" data-platform={platform}>
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <a
        href={familyPath}
        class="mb-6 inline-flex min-h-11 items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/60"
      >
        <ArrowLeft className="size-4" aria-hidden="true" />
        {t(locale, "addons.editions.backToFamily")}
      </a>

      <header class="border-b pb-8 sm:pb-10">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">
              {t(locale, "addons.editions.platformEdition")}
            </p>
            <div class="mt-4 flex items-start gap-4">
              <div class="flex size-14 shrink-0 items-center justify-center rounded-2xl border bg-card shadow-sm">
                {showBrandLogo && plugin.brandLogo ? (
                  <BrandLogo brand={plugin.brandLogo} context="addon" className="size-8 rounded-lg" alt={plugin.name} />
                ) : plugin.iconUrl ? (
                  <img src={plugin.iconUrl} alt={plugin.name} class="size-8 rounded-lg" />
                ) : plugin.icon === "Gem" ? (
                  <Gem className="size-7 text-muted-foreground" />
                ) : (
                  <Plug className="size-7 text-muted-foreground" />
                )}
              </div>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2.5">
                  <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
                    {pageTitle}
                  </h1>
                  <Badge variant="secondary" className="text-[10px]">
                    {t(locale, sourceKeys[plugin.source])}
                  </Badge>
                </div>
                <p class="mt-3 max-w-2xl text-base leading-7 text-muted-foreground sm:text-lg">
                  {edition.description}
                </p>
              </div>
            </div>
          </div>

          <AddonEditionSwitcher
            editions={editions}
            familyPath={familyPath}
            locale={locale}
            currentPlatform={platform}
          />
        </div>

        <dl class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <div class="rounded-xl border bg-card px-4 py-3">
            <dt class="text-xs font-medium uppercase tracking-[0.12em] text-muted-foreground">
              {t(locale, "addons.editions.version")}
            </dt>
            <dd class="mt-1 font-mono text-sm font-semibold">{edition.version}</dd>
          </div>
          {edition.id && (
            <div class="min-w-0 rounded-xl border bg-card px-4 py-3">
              <dt class="text-xs font-medium uppercase tracking-[0.12em] text-muted-foreground">
                {t(locale, "addons.editions.pluginId")}
              </dt>
              <dd class="mt-1 truncate font-mono text-sm font-semibold" title={edition.id}>{edition.id}</dd>
            </div>
          )}
          {edition.requirements && edition.requirements.length > 0 && (
            <div class="rounded-xl border bg-card px-4 py-3 sm:col-span-2 lg:col-span-1">
              <dt class="text-xs font-medium uppercase tracking-[0.12em] text-muted-foreground">
                {t(locale, "addons.editions.requirements")}
              </dt>
              <dd class="mt-1 text-sm font-semibold">{edition.requirements.join(" · ")}</dd>
            </div>
          )}
        </dl>

        <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
          {plugin.apiDocsUrl && (
            <a href={plugin.apiDocsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-1.5 rounded-lg text-sm font-medium text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/60">
              <ExternalLink className="size-3.5" aria-hidden="true" /> {t(locale, "addons.apiDocs")}
            </a>
          )}
          {edition.sourceUrl && (
            <a href={edition.sourceUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-1.5 rounded-lg text-sm font-medium text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/60">
              <ExternalLink className="size-3.5" aria-hidden="true" /> {platformLabel} {t(locale, "addons.sourceCode")}
            </a>
          )}
          {edition.releaseUrl && (
            <a href={edition.releaseUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-1.5 rounded-lg text-sm font-medium text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/60">
              <ExternalLink className="size-3.5" aria-hidden="true" /> {t(locale, "addons.editions.release")} {edition.releaseVersion ?? edition.version}
            </a>
          )}
        </div>
      </header>

      {screenshots.length > 0 && (
        <section class="mt-10" aria-labelledby="edition-screenshots">
          <h2 id="edition-screenshots" class="font-display text-xl font-bold sm:text-2xl">
            {t(locale, "addons.editions.screenshots")}
          </h2>
          <div class="mt-5 grid gap-6">
            {screenshots.map((screenshot) => (
              <figure class="overflow-hidden rounded-2xl border bg-card shadow-lg">
                <picture>
                  <source srcset={screenshot.webpSrc} type="image/webp" />
                  <img
                    src={screenshot.src}
                    alt={screenshot.alt}
                    class="h-auto w-full"
                    loading="eager"
                  />
                </picture>
                {screenshot.caption && (
                  <figcaption class="border-t px-4 py-3 text-sm leading-6 text-muted-foreground sm:px-5">
                    {screenshot.caption}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        </section>
      )}

      {((edition.highlights?.length ?? 0) > 0 || (edition.configuration?.length ?? 0) > 0) && (
        <div class="mt-10 grid gap-6 border-t pt-8 sm:mt-12 sm:pt-10 lg:grid-cols-2">
          {edition.highlights && edition.highlights.length > 0 && (
            <section class="rounded-2xl border bg-card p-5 sm:p-6" aria-labelledby="edition-features">
              <div class="flex items-center gap-3">
                <span class="flex size-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
                  <Check className="size-5" aria-hidden="true" />
                </span>
                <h2 id="edition-features" class="font-display text-xl font-bold">
                  {t(locale, "addons.editions.features")}
                </h2>
              </div>
              <ul class="mt-5 space-y-3">
                {edition.highlights.map((highlight) => (
                  <li class="flex gap-3 text-sm leading-6 text-muted-foreground">
                    <Check className="mt-1 size-4 shrink-0 text-primary" aria-hidden="true" />
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {edition.configuration && edition.configuration.length > 0 && (
            <section class="rounded-2xl border bg-card p-5 sm:p-6" aria-labelledby="edition-settings">
              <div class="flex items-center gap-3">
                <span class="flex size-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
                  <SlidersHorizontal className="size-5" aria-hidden="true" />
                </span>
                <h2 id="edition-settings" class="font-display text-xl font-bold">
                  {t(locale, "addons.editions.settings")}
                </h2>
              </div>
              <ul class="mt-5 space-y-3">
                {edition.configuration.map((setting) => (
                  <li class="flex gap-3 text-sm leading-6 text-muted-foreground">
                    <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
                    <span>{setting}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>
      )}

      {GuideContent ? (
        <div class="addon-prose prose prose-neutral dark:prose-invert mt-10 max-w-none border-t pt-8 sm:mt-12 sm:pt-10">
          <GuideContent />
        </div>
      ) : (
        <AddonEditionGuide edition={edition} plugin={plugin} locale={locale} />
      )}
    </div>
  </div>
</BaseLayout>

<style>
  :global(.addon-prose table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }
</style>
