---
import "@/styles/addons.css";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AddonEditionGuide from "@/components/addons/addon-edition-guide.astro";
import AddonHead from "@/components/addons/addon-head.astro";
import AddonHostRequirement from "@/components/addons/addon-host-requirement.astro";
import AddonEditionSwitcher from "@/components/addons/addon-edition-switcher.astro";
import AddonShot from "@/components/addons/addon-shot.astro";
import AddonToc from "@/components/addons/addon-toc.astro";
import { addonShotText } from "@/components/addons/shot-text";
import {
  addonEditionHasGuide,
  editionPlatformSlugs,
  getDefaultAddonEditionScreenshot,
  getAddonEditionModules,
  getAddonEditions,
  type AddonEditionScreenshot,
} from "@/data/addon-editions";
import {
  getPlugin,
  getPluginModule,
  platformKeys,
  sourceKeys,
  type Plugin,
  type PluginPlatform,
} from "@/data/addons";
import {
  locales,
  screenshotPath,
  t,
  type Locale,
} from "@/i18n/index";
import { canonicalPath } from "@/lib/locale-routes";
import { ArrowUpRight } from "lucide-react";

interface Props {
  locale: Locale;
  plugin: Plugin;
  platform: PluginPlatform;
}

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    getAddonEditionModules(locale).flatMap((mod) => {
      const edition = mod.frontmatter;
      const plugin = getPlugin(edition.familySlug, locale);

      if (!plugin) {
        return [];
      }

      return [
        {
          params: {
            locale,
            slug: edition.familySlug,
            platform: editionPlatformSlugs[edition.platform],
          },
          props: { locale, plugin, platform: edition.platform },
        },
      ];
    }),
  );
}

const { locale, plugin, platform } = Astro.props;
const editions = getAddonEditions(plugin.slug, locale);
const editionModule = getAddonEditionModules(locale).find(
  (mod) =>
    mod.frontmatter.familySlug === plugin.slug &&
    mod.frontmatter.platform === platform,
);

if (!editionModule) {
  throw new Error(`Missing ${platform} edition for ${plugin.slug} (${locale})`);
}

const edition = editionModule.frontmatter;
const editionHasGuide = addonEditionHasGuide(plugin.slug, platform, locale);
const familyModule =
  platform === "mac" ? getPluginModule(plugin.slug, locale) : undefined;
const GuideContent = editionHasGuide
  ? editionModule.default
  : familyModule?.default;
const platformLabel = t(locale, platformKeys[platform]);
const familyPath = canonicalPath(locale, `/addons/${plugin.slug}`);
const editionPath = `${familyPath}${editionPlatformSlugs[platform]}/`;
const pageTitle = `${plugin.name} ${t(locale, "addons.editions.for")} ${platformLabel}`;
const configuredScreenshots = edition.screenshots ?? [];
const defaultScreenshot = getDefaultAddonEditionScreenshot(edition);
const editionScreenshots: AddonEditionScreenshot[] =
  configuredScreenshots.length > 0
    ? configuredScreenshots
    : defaultScreenshot
      ? [defaultScreenshot]
      : [];
const screenshots = editionScreenshots.map((screenshot) => ({
  ...addonShotText(locale, {
    name: plugin.name,
    platform,
    alt: screenshot.alt,
    caption: screenshot.caption,
  }),
  src:
    screenshot.localized === false
      ? screenshot.src
      : screenshotPath(locale, screenshot.src),
}));
const links = [
  ...(plugin.apiDocsUrl
    ? [{ label: t(locale, "addons.apiDocs"), url: plugin.apiDocsUrl }]
    : []),
  ...(edition.sourceUrl
    ? [
        {
          label: `${platformLabel} ${t(locale, "addons.sourceCode")}`,
          url: edition.sourceUrl,
        },
      ]
    : []),
  ...(edition.releaseUrl
    ? [
        {
          label: `${t(locale, "addons.editions.release")} ${edition.releaseVersion ?? edition.version}`,
          url: edition.releaseUrl,
        },
      ]
    : []),
];
const hasHighlights = (edition.highlights?.length ?? 0) > 0;
const hasConfiguration = (edition.configuration?.length ?? 0) > 0;

type Heading = { depth: number; slug: string; text: string };
const guideModule = (editionHasGuide ? editionModule : familyModule) as
  | { getHeadings?: () => Heading[] }
  | undefined;
const guideHeadings = GuideContent
  ? (guideModule?.getHeadings?.() ?? []).filter((heading) => heading.depth === 2)
  : [
      {
        depth: 2,
        slug: "edition-guide-heading",
        text: t(locale, "addons.editions.guide.heading"),
      },
    ];
const headings: Heading[] = [
  ...(screenshots.length > 0
    ? [
        {
          depth: 2,
          slug: "edition-screenshots",
          text: t(locale, "addons.editions.screenshots"),
        },
      ]
    : []),
  ...(hasHighlights
    ? [
        {
          depth: 2,
          slug: "edition-features",
          text: t(locale, "addons.editions.features"),
        },
      ]
    : []),
  ...(hasConfiguration
    ? [
        {
          depth: 2,
          slug: "edition-settings",
          text: t(locale, "addons.editions.settings"),
        },
      ]
    : []),
  ...guideHeadings,
];
---

<BaseLayout
  searchPlatforms={[platform]}
  title={`${pageTitle} - TypeWhisper Add-ons`}
  description={edition.description}
  canonicalPath={editionPath}
  locale={locale}
>
  <div
    class="site-page addon-page"
    data-testid="addon-edition-detail"
    data-platform={platform}
  >
    <AddonHead
      locale={locale}
      crumbs={[
        { label: t(locale, "addons.heading"), href: canonicalPath(locale, "/addons") },
        { label: plugin.name, href: familyPath },
        { label: platformLabel },
      ]}
      label={t(locale, "addons.editions.platformEdition")}
      title={pageTitle}
      lede={edition.description}
      plugin={plugin}
    >
      <Fragment slot="meta">
        <li>{t(locale, "addons.by")} {plugin.author}</li>
        <li>{t(locale, sourceKeys[plugin.source])}</li>
      </Fragment>
      {links.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="site-link"
        >
          {link.label}
          <ArrowUpRight className="size-4" aria-hidden="true" />
        </a>
      ))}
      <AddonEditionSwitcher
        slot="aside"
        editions={editions}
        familyPath={familyPath}
        locale={locale}
        currentPlatform={platform}
      />
    </AddonHead>

    <div class="addon-facts-band">
      <dl class="site-wrap addon-facts">
        <div>
          <dt>{t(locale, "addons.editions.version")}</dt>
          <dd class="addon-facts__mono">{edition.version}</dd>
        </div>
        {
          edition.id && (
            <div>
              <dt>{t(locale, "addons.editions.pluginId")}</dt>
              <dd class="addon-facts__mono">
                {edition.id.split(".").map((part, index) => (
                  <Fragment>{index > 0 && <Fragment>.<wbr /></Fragment>}{part}</Fragment>
                ))}
              </dd>
            </div>
          )
        }
        {
          edition.requirements && edition.requirements.length > 0 && (
            <div>
              <dt>{t(locale, "addons.editions.requirements")}</dt>
              <dd>{edition.requirements.join(" · ")}</dd>
            </div>
          )
        }
      </dl>
    </div>

    <section class="site-section addon-section">
      <div class="site-wrap addon-doc addon-doc--toc">
        <aside class="addon-doc__aside">
          <AddonToc headings={headings} locale={locale} />
        </aside>

        <div class="addon-doc__main">
          <AddonHostRequirement platform={platform} minAppVersion={edition.minAppVersion} locale={locale} />

          <div class="site-prose addon-prose">
            {
              screenshots.length > 0 && (
                <section aria-labelledby="edition-screenshots">
                  <h2 id="edition-screenshots">
                    {t(locale, "addons.editions.screenshots")}
                  </h2>
                  {screenshots.map((screenshot) => (
                    <AddonShot
                      src={screenshot.src}
                      alt={screenshot.alt}
                      caption={screenshot.caption}
                      captionRepeatsAlt={screenshot.captionRepeatsAlt}
                      loading="eager"
                    />
                  ))}
                </section>
              )
            }

            {
              hasHighlights && (
                <section aria-labelledby="edition-features">
                  <h2 id="edition-features">
                    {t(locale, "addons.editions.features")}
                  </h2>
                  <ul>
                    {edition.highlights?.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                </section>
              )
            }

            {
              hasConfiguration && (
                <section aria-labelledby="edition-settings">
                  <h2 id="edition-settings">
                    {t(locale, "addons.editions.settings")}
                  </h2>
                  <ul>
                    {edition.configuration?.map((setting) => (
                      <li>{setting}</li>
                    ))}
                  </ul>
                </section>
              )
            }

            {
              GuideContent ? (
                <div class="addon-prose__guide">
                  <GuideContent />
                </div>
              ) : (
                <AddonEditionGuide
                  edition={edition}
                  plugin={plugin}
                  locale={locale}
                />
              )
            }
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
