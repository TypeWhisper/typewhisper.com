---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Badge } from "@/components/ui/badge";
import { BrandLogo, canRenderBrandLogo } from "@/components/ui/brand-logo";
import CommunityContent from "@/components/addons/community-content";
import {
  getPlugins,
  getPluginModule,
  isCommunityPlugin,
  categoryKeys,
  platformKeys,
  sourceKeys,
} from "@/data/addons";
import { t, locales } from "@/i18n/index";
import { canonicalPath } from "@/lib/locale-routes";
import {
  Zap, Brain, Sparkles, Send, SquareKanban, Cpu, Radio,
  AudioLines, Waves, Mic, Plug, AudioWaveform, Gem, Terminal,
  Captions, Cloud, Flame, Globe, HardDrive, Mountain, Search,
  ShieldCheck, ArrowLeft, ExternalLink,
} from "lucide-react";

const iconMap: Record<string, any> = {
  Zap, Brain, Sparkles, Send, SquareKanban, Cpu, Radio,
  AudioLines, Waves, Mic, Plug, AudioWaveform, Gem, Terminal,
  Captions, Cloud, Flame, Globe, HardDrive, Mountain, Search,
  ShieldCheck,
};

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    getPlugins(locale).map((plugin) => ({
      params: { locale, slug: plugin.slug },
      props: { locale, plugin },
    })),
  );
}

const { locale, plugin } = Astro.props;
const mod = getPluginModule(plugin.slug, locale);
const Icon = iconMap[plugin.icon];
const isCommunity = isCommunityPlugin(plugin);
const showBrandLogo = plugin.brandLogo
  ? canRenderBrandLogo(plugin.brandLogo, "addon")
  : false;
const sourceLinks = plugin.sourceUrls
  ? Object.entries(plugin.sourceUrls)
      .filter(([, url]) => Boolean(url))
      .map(([platform, url]) => ({
        label: `${t(locale, platformKeys[platform as keyof typeof platformKeys])} ${t(locale, "addons.sourceCode")}`,
        url: url as string,
      }))
  : plugin.sourceUrl
    ? [{ label: t(locale, "addons.sourceCode"), url: plugin.sourceUrl }]
    : [];
---
<BaseLayout
  title={`${plugin.name} - TypeWhisper Add-ons`}
  description={plugin.description}
  canonicalPath={canonicalPath(locale, `/addons/${plugin.slug}`)}
  locale={locale}
>
  <div class="py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <a href={canonicalPath(locale, "/addons")} class="mb-6 inline-flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-accent transition-colors">
        <ArrowLeft className="size-4" />
        {t(locale, "addons.backToAddons")}
      </a>

      <div class="flex items-start gap-4">
        <div class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-muted">
          {showBrandLogo && plugin.brandLogo ? (
            <BrandLogo brand={plugin.brandLogo} context="addon" className="size-8 rounded-lg" alt={plugin.name} />
          ) : plugin.iconUrl ? (
            <img src={plugin.iconUrl} alt={plugin.name} class="size-8 rounded-lg" />
          ) : Icon ? (
            <Icon className="size-7 text-muted-foreground" />
          ) : null}
        </div>
        <div>
          <div class="flex items-center gap-3">
            <h1 class="font-display text-2xl font-bold">{plugin.name}</h1>
            <Badge variant="secondary" className="text-[10px]">
              {t(locale, sourceKeys[plugin.source])}
            </Badge>
          </div>
          <p class="mt-0.5 text-sm text-muted-foreground">
            {t(locale, "addons.by")} {plugin.authorUrl ? (
              <a href={plugin.authorUrl} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">{plugin.author}</a>
            ) : plugin.author}
          </p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            {plugin.categories.map((cat) => (
              <Badge variant="outline" className="text-[10px]">{t(locale, categoryKeys[cat])}</Badge>
            ))}
            {plugin.platforms.map((platform) => (
              <Badge variant="outline" className="text-[10px] border-primary/30 text-primary/70">{t(locale, platformKeys[platform])}</Badge>
            ))}
          </div>
        </div>
      </div>

      {(plugin.apiDocsUrl || sourceLinks.length > 0 || plugin.homepage) && (
        <div class="mt-6 flex flex-wrap gap-4">
          {plugin.homepage && (
            <a href={plugin.homepage} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm text-primary hover:underline">
              <ExternalLink className="size-3.5" /> {t(locale, "addons.homepage")}
            </a>
          )}
          {plugin.apiDocsUrl && (
            <a href={plugin.apiDocsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm text-primary hover:underline">
              <ExternalLink className="size-3.5" /> {t(locale, "addons.apiDocs")}
            </a>
          )}
          {sourceLinks.map((sourceLink) => (
            <a href={sourceLink.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm text-primary hover:underline">
              <ExternalLink className="size-3.5" /> {sourceLink.label}
            </a>
          ))}
        </div>
      )}

      <div class="mt-8">
        <picture>
          <source srcset={`/screenshots/${locale}/plugins/${plugin.slug}.webp`} type="image/webp" />
          <img
            src={`/screenshots/${locale}/plugins/${plugin.slug}.png`}
            alt={`${plugin.name} ${t(locale, "addons.settingsAlt")}`}
            class="rounded-2xl border shadow-lg"
            onerror="this.parentElement.style.display='none'"
          />
        </picture>
      </div>

      {mod ? (
        <div class="addon-prose prose prose-neutral dark:prose-invert mt-10 max-w-none">
          <mod.default />
        </div>
      ) : isCommunity ? (
        <CommunityContent client:load plugin={plugin} />
      ) : null}
    </div>
  </div>
</BaseLayout>

<style>
  :global(.addon-prose table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }
</style>
