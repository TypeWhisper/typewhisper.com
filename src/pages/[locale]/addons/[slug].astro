---
import "@/styles/addons.css";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CommunityContent from "@/components/addons/community-content";
import AddonEditionCard from "@/components/addons/addon-edition-card.astro";
import AddonHead from "@/components/addons/addon-head.astro";
import AddonHostRequirement from "@/components/addons/addon-host-requirement.astro";
import AddonShot from "@/components/addons/addon-shot.astro";
import AddonToc from "@/components/addons/addon-toc.astro";
import { addonShotText } from "@/components/addons/shot-text";
import {
  getAddonEditions,
  getDefaultAddonDetailScreenshot,
} from "@/data/addon-editions";
import {
  getPlugins,
  getPluginModule,
  isCommunityPlugin,
  categoryKeys,
  platformKeys,
  sourceKeys,
} from "@/data/addons";
import { screenshotPath, t, locales } from "@/i18n/index";
import { canonicalPath } from "@/lib/locale-routes";
import { ArrowUpRight } from "lucide-react";

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    getPlugins(locale).map((plugin) => ({
      params: { locale, slug: plugin.slug },
      props: { locale, plugin },
    })),
  );
}

const { locale, plugin } = Astro.props;
const mod = getPluginModule(plugin.slug, locale);
const editions = getAddonEditions(plugin.slug, locale);
const isFamily = editions.length > 0;
const isCommunity = isCommunityPlugin(plugin);
const defaultScreenshot = plugin.screenshots === false ? undefined : getDefaultAddonDetailScreenshot(plugin);
const defaultScreenshotSrc = defaultScreenshot
  ? defaultScreenshot.localized === false
    ? defaultScreenshot.src
    : screenshotPath(locale, defaultScreenshot.src)
  : undefined;
const sourceLinks = plugin.sourceUrls
  ? Object.entries(plugin.sourceUrls)
      .filter(([, url]) => Boolean(url))
      .map(([platform, url]) => ({
        label: `${t(locale, platformKeys[platform as keyof typeof platformKeys])} ${t(locale, "addons.sourceCode")}`,
        url: url as string,
      }))
  : plugin.sourceUrl
    ? [{ label: t(locale, "addons.sourceCode"), url: plugin.sourceUrl }]
    : [];
// A family names its editions; their pages carry releases and source links.
const links = isFamily
  ? plugin.apiDocsUrl
    ? [{ label: t(locale, "addons.apiDocs"), url: plugin.apiDocsUrl }]
    : []
  : [
      ...(plugin.homepage
        ? [{ label: t(locale, "addons.homepage"), url: plugin.homepage }]
        : []),
      ...(plugin.apiDocsUrl
        ? [{ label: t(locale, "addons.apiDocs"), url: plugin.apiDocsUrl }]
        : []),
      ...(plugin.releaseUrl
        ? [
            {
              label: `${t(locale, "addons.editions.release")} ${plugin.version ?? ""}`.trim(),
              url: plugin.releaseUrl,
            },
          ]
        : []),
      ...sourceLinks,
    ];
const categories = plugin.categories
  .map((category) => t(locale, categoryKeys[category]))
  .join(" · ");
const platforms = plugin.platforms
  .map((platform) => t(locale, platformKeys[platform]))
  .join(" · ");
const shot = addonShotText(locale, {
  name: plugin.name,
  platform:
    plugin.platforms.length === 1 && plugin.platforms[0] === "windows"
      ? "windows"
      : "mac",
  alt: plugin.screenshotAlt,
  caption: plugin.screenshotCaption,
});
const headings = (
  (mod as { getHeadings?: () => { depth: number; slug: string; text: string }[] } | undefined)
    ?.getHeadings?.() ?? []
).filter((heading) => heading.depth === 2);
const hasToc = !isFamily && Boolean(mod) && headings.length > 1;
---

<BaseLayout
  searchPlatforms={plugin.platforms}
  title={`${plugin.name} - TypeWhisper Add-ons`}
  description={plugin.description}
  canonicalPath={canonicalPath(locale, `/addons/${plugin.slug}`)}
  locale={locale}
>
  <div class="site-page addon-page">
    <AddonHead
      locale={locale}
      crumbs={[
        { label: t(locale, "addons.heading"), href: canonicalPath(locale, "/addons") },
        { label: plugin.name },
      ]}
      label={isFamily ? t(locale, "addons.editions.eyebrow") : categories}
      title={plugin.name}
      lede={plugin.description}
      plugin={plugin}
      testId={isFamily ? "addon-edition-family" : undefined}
    >
      <Fragment slot="meta">
        <li>
          {t(locale, "addons.by")}{" "}
          {!isFamily && plugin.authorUrl ? (
            <a href={plugin.authorUrl} target="_blank" rel="noopener noreferrer">
              {plugin.author}
            </a>
          ) : (
            plugin.author
          )}
        </li>
        <li>{t(locale, sourceKeys[plugin.source])}</li>
        {isFamily && <li>{categories}</li>}
        <li>{platforms}</li>
      </Fragment>
      {links.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="site-link"
        >
          {link.label}
          <ArrowUpRight className="size-4" aria-hidden="true" />
        </a>
      ))}
    </AddonHead>

    {
      isFamily ? (
        <section class="site-section addon-section" aria-labelledby="edition-heading">
          <div class="site-wrap">
            <h2 id="edition-heading" class="site-subtitle">
              {t(locale, "addons.editions.heading")}
            </h2>
            <p class="site-text addon-section__lede">
              {t(locale, "addons.editions.description")}
            </p>

            <ul class="site-tiers site-tiers--2 addon-editions">
              {editions.map((edition) => (
                <AddonEditionCard
                  edition={edition}
                  name={plugin.name}
                  familyPath={canonicalPath(locale, `/addons/${plugin.slug}`)}
                  locale={locale}
                />
              ))}
            </ul>
          </div>
        </section>
      ) : (
        <section class="site-section addon-section">
          <div class:list={["site-wrap addon-doc", hasToc && "addon-doc--toc"]}>
            {hasToc && (
              <aside class="addon-doc__aside">
                <AddonToc headings={headings} locale={locale} />
              </aside>
            )}
            <div class="addon-doc__main">
              {plugin.platforms.length === 1 && (
                <AddonHostRequirement platform={plugin.platforms[0]} minAppVersion={plugin.minAppVersion} locale={locale} />
              )}

              {defaultScreenshotSrc && (
                <AddonShot
                  src={defaultScreenshotSrc}
                  alt={shot.alt}
                  caption={shot.caption}
                  captionRepeatsAlt={shot.captionRepeatsAlt}
                  loading="eager"
                />
              )}

              {mod ? (
                <div class="site-prose addon-prose">
                  <mod.default />
                </div>
              ) : isCommunity ? (
                <CommunityContent client:load plugin={plugin} locale={locale} />
              ) : null}
            </div>
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
