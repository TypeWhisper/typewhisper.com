---
import "@/styles/utility.css";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ArrowRight, ArrowUpRight } from "lucide-react";
import { BarMark, PageHead, WaveRule } from "@/components/site";
import { t, localePath, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";
import {
  discordUrl,
  getIosAppStoreUrl,
  iosVersion,
} from "@/lib/platform-download";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const iosAppStoreUrl = getIosAppStoreUrl(locale);

interface SupportLink {
  label: string;
  href: string;
  external?: boolean;
  attributes?: Record<string, string>;
}

const platforms: { id: string; links: SupportLink[] }[] = [
  {
    id: "mac",
    links: [
      {
        label: t(locale, "support.mac.reportIssue"),
        href: "https://github.com/TypeWhisper/typewhisper-mac/issues",
        external: true,
      },
      {
        label: t(locale, "support.mac.troubleshooting"),
        href: localePath(locale, "/docs/mac/troubleshooting"),
      },
      {
        label: t(locale, "support.mac.prompts"),
        href: localePath(locale, "/docs/mac/workflows"),
      },
    ],
  },
  {
    id: "win",
    links: [
      {
        label: t(locale, "support.win.reportIssue"),
        href: "https://github.com/TypeWhisper/typewhisper-win/issues",
        external: true,
      },
      {
        label: t(locale, "support.win.docs"),
        href: localePath(locale, "/docs/windows"),
      },
    ],
  },
  {
    id: "ios",
    links: [
      {
        label: t(locale, "support.ios.contact"),
        href: "mailto:hello@typewhisper.com",
      },
      {
        label: t(locale, "support.ios.appStore"),
        href: iosAppStoreUrl,
        external: true,
        attributes: {
          "data-download-social-trigger": "",
          "data-download-platform": "ios",
          "data-download-target": "ios_app_store",
          "data-download-version": iosVersion,
          "data-tracking-placement": "support",
        },
      },
    ],
  },
];

const community: SupportLink[] = [
  {
    label: t(locale, "support.community.discord"),
    href: discordUrl,
    external: true,
  },
  {
    label: t(locale, "support.community.github"),
    href: "https://github.com/TypeWhisper",
    external: true,
  },
];
---

<BaseLayout
  title={`${t(locale, "support.title")} - TypeWhisper`}
  description={t(locale, "support.meta.description")}
  canonicalPath={canonicalPath(locale, "/support")}
  locale={locale}
>
  <div class="site-page">
    <PageHead
      label={t(locale, "support.label")}
      title={t(locale, "support.title")}
      lede={t(locale, "support.subtitle")}
    />

    <section class="site-section site-section--tight-top" data-testid="support-platforms">
      <div class="site-wrap">
        <WaveRule label={t(locale, "support.platforms.label")} seed={5} />
        <ul class="site-grid utility-platforms">
          {platforms.map((platform) => (
            <li class="site-grid__item">
              <h2 class="site-heading">{t(locale, `support.${platform.id}.title`)}</h2>
              <p class="site-text">{t(locale, `support.${platform.id}.description`)}</p>
              <ul class="utility-links">
                {platform.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="site-link"
                      target={link.external ? "_blank" : undefined}
                      rel={link.external ? "noopener noreferrer" : undefined}
                      {...link.attributes}
                    >
                      {link.label}
                      {link.external
                        ? <ArrowUpRight className="size-4" aria-hidden="true" />
                        : <ArrowRight className="size-4" aria-hidden="true" />}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="site-section site-section--band">
      <div class="site-wrap">
        <WaveRule label={t(locale, "support.beforeReport.label")} seed={9} />
        <div class="site-split">
          <div class="site-split__head">
            <h2 class="site-title site-title--start">{t(locale, "support.beforeReport.title")}</h2>
          </div>
          <ul class="site-points">
            {[1, 2, 3, 4].map((item) => (
              <li class="site-points__item">
                <BarMark className="site-points__mark utility-point__mark" />
                <p class="utility-point">{t(locale, `support.beforeReport.item${item}`)}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="site-section">
      <div class="site-wrap">
        <WaveRule label={t(locale, "support.community.label")} seed={13} />
        <div class="site-split">
          <div class="site-split__head">
            <h2 class="site-title site-title--start">{t(locale, "support.community.title")}</h2>
            <p class="site-lede site-lede--start">{t(locale, "support.community.description")}</p>
          </div>
          <ul class="utility-rows">
            {community.map((link) => (
              <li>
                <a href={link.href} class="utility-rows__link" target="_blank" rel="noopener noreferrer">
                  <span class="utility-rows__name">{link.label}</span>
                  <ArrowUpRight className="size-5" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
