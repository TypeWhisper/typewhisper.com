---
import { type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const target = canonicalPath(locale, "/docs/windows/workflows");
---
<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </head>
  <body></body>
</html>
