---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsWindowsProfiles from "@/pages/docs/windows/_profiles.tsx";
import { type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const copy = locale === "de"
  ? {
      title: "Profiles - Windows Beta - TypeWhisper",
      description: "Konfiguriere app-spezifische Einstellungen für Sprache, Engine und Aufgabe in der TypeWhisper Windows-Beta.",
      releaseTitle: "Windows ist derzeit eine öffentliche Beta.",
      releaseDescription: "Profil-Zuordnung funktioniert fürs Testen bereits gut, aber Feinschliff und Edge-Case-Behandlung entwickeln sich noch weiter.",
    }
  : {
      title: "Profiles - Windows Beta - TypeWhisper",
      description: "Configure app-specific settings for language, engine, and task in the TypeWhisper Windows beta.",
      releaseTitle: "Windows is currently a public beta.",
      releaseDescription: "Profile matching already works well for testing, but polish and edge-case handling are still evolving.",
    };
---
<DocsLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath(locale, "/docs/windows/profiles")}
  locale={locale}
  platform="windows"
  releaseStage="beta"
  releaseTitle={copy.releaseTitle}
  releaseDescription={copy.releaseDescription}
>
  <DocsWindowsProfiles locale={locale} />
</DocsLayout>
