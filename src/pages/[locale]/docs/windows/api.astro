---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsWindowsAPI from "@/pages/docs/windows/_api.tsx";
import { t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const copy = locale === "de"
  ? {
      title: "HTTP API - Windows - TypeWhisper",
      description: "Aktuelle HTTP-API-Endpunkte von TypeWhisper für Windows zur Integration lokaler Tools.",
    }
  : {
      title: "HTTP API - Windows - TypeWhisper",
      description: "Current TypeWhisper Windows HTTP API endpoints for local tool integration.",
    };
---
<DocsLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath(locale, "/docs/windows/api")}
  locale={locale}
  platform="windows"
  releaseStage="stable"
  releaseTitle={t(locale, "docs.win.release.title")}
  releaseDescription={t(locale, "docs.win.release.apiDescription")}
>
  <DocsWindowsAPI locale={locale} />
</DocsLayout>
