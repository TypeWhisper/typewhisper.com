---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsWindowsAPI from "@/pages/docs/windows/_api.tsx";
import { type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const copy = locale === "de"
  ? {
      title: "HTTP API - Windows Beta - TypeWhisper",
      description: "Aktuelle HTTP-API-Endpunkte der TypeWhisper Windows-Beta für die Integration lokaler Tools.",
      releaseTitle: "Windows ist derzeit eine öffentliche Beta.",
      releaseDescription: "Die Windows-API ist bereits für lokale Tools nutzbar, aber das Gesamtprodukt befindet sich noch in der Beta.",
    }
  : {
      title: "HTTP API - Windows Beta - TypeWhisper",
      description: "Current TypeWhisper Windows beta HTTP API endpoints for local tool integration.",
      releaseTitle: "Windows is currently a public beta.",
      releaseDescription: "The Windows API is already useful for local tooling, but the surrounding product is still in beta.",
    };
---
<DocsLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath(locale, "/docs/windows/api")}
  locale={locale}
  platform="windows"
  releaseStage="beta"
  releaseTitle={copy.releaseTitle}
  releaseDescription={copy.releaseDescription}
>
  <DocsWindowsAPI locale={locale} />
</DocsLayout>
