---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsWindowsDeployment, {
  windowsDeploymentHead,
} from "@/pages/docs/windows/_deployment.tsx";
import { type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const copy = locale === "de"
  ? {
      title: "Bereitstellung - Windows - TypeWhisper",
      description: "TypeWhisper für Windows in Organisationen verteilen: MSI für alle Benutzer, Setup pro Benutzer, Intune-Pakete, Netzwerk-Hosts und Mikrofonzugriff.",
    }
  : {
      title: "Deployment - Windows - TypeWhisper",
      description: "Roll out TypeWhisper for Windows across an organization: machine-wide MSI, per-user setup, Intune packages, network hosts, and microphone access.",
    };
const head = windowsDeploymentHead(locale);
---
<DocsLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath(locale, "/docs/windows/deployment")}
  locale={locale}
  platform="windows"
  heading={head.heading}
  lede={head.lede}
>
  <DocsWindowsDeployment locale={locale} />
</DocsLayout>
