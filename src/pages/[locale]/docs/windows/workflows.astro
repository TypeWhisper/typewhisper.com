---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsWindowsWorkflows, { windowsWorkflowsHead } from "@/pages/docs/windows/_workflows.tsx";
import { t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const copy = locale === "de"
  ? {
      title: "Workflows - Windows - TypeWhisper",
      description: "TypeWhisper-Workflows für Apps, Websites, Tastenkürzel, KI-Nachbearbeitung und Aktionen konfigurieren.",
    }
  : {
      title: "Workflows - Windows - TypeWhisper",
      description: "Configure TypeWhisper workflows for apps, websites, hotkeys, AI post-processing, and actions.",
    };
const head = windowsWorkflowsHead(locale);
---
<DocsLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath(locale, "/docs/windows/workflows")}
  locale={locale}
  platform="windows"
  heading={head.heading}
  lede={head.lede}
>
  <DocsWindowsWorkflows locale={locale} />
</DocsLayout>
