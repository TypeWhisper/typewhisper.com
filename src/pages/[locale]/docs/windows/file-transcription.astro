---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsWindowsFileTranscription, { windowsFileTranscriptionHead } from "@/pages/docs/windows/_file-transcription.tsx";
import { t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const copy = locale === "de"
  ? {
      title: "Datei-Transkription - Windows - TypeWhisper",
      description: "Audio- und Videodateien mit Queue, Export und Watch Folder in TypeWhisper für Windows transkribieren.",
    }
  : {
      title: "File Transcription - Windows - TypeWhisper",
      description: "Transcribe audio and video files with a queue, export, and watch folder in TypeWhisper for Windows.",
    };
const head = windowsFileTranscriptionHead(locale);
---
<DocsLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath(locale, "/docs/windows/file-transcription")}
  locale={locale}
  platform="windows"
  heading={head.heading}
  lede={head.lede}
>
  <DocsWindowsFileTranscription locale={locale} />
</DocsLayout>
