---
import DocsLayout from "@/layouts/DocsLayout.astro";
import { DocsFigure } from "@/components/docs/prose";
import { screenshotPath, t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";
import { ArrowRight } from "lucide-react";

interface Props {
  locale: Locale;
}

type WindowsEntry = [slug: string, title: string, description: string];

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const copy = locale === "de"
  ? {
      title: "Windows-Dokumentation - TypeWhisper",
      description: "Dokumentation für TypeWhisper auf Windows.",
      heading: "Windows-Dokumentation",
      intro: "Die Windows-App ist stabil für den täglichen Einsatz mit systemweitem Diktat, Datei-Transkription, Workflows, Verlauf, Wörterbuch, Snippets und Integrationen.",
      cards: [
        ["installation", "Installation", "Store, Installer, vierstufiges Onboarding, Updates und Deinstallation."],
        ["features", "Funktionen", "Diktat, Tastenkürzel, Modelle, Wörterbuch, Recorder und Integrationen."],
        ["file-transcription", "Datei-Transkription", "Queue, Formate, Export und Watch Folder."],
        ["workflows", "Workflows", "Vorlagen, Trigger, Nachbearbeitung und Ausgabe."],
        ["api", "HTTP API", "Lokale API für Transkription, Diktat, Recorder und Wörterbuch."],
        ["cli", "CLI Tool", "TypeWhisper aus PowerShell und Skripten verwenden."],
        ["troubleshooting", "Fehlerbehebung", "Installation, Mikrofon, Einfügen, Modelle und API diagnostizieren."],
      ],
    }
  : {
      title: "Windows Documentation - TypeWhisper",
      description: "Documentation for TypeWhisper on Windows.",
      heading: "Windows Documentation",
      intro: "The Windows app is stable for daily use with system-wide dictation, file transcription, workflows, history, dictionary, snippets, and integrations.",
      cards: [
        ["installation", "Installation", "Store, installers, four-step onboarding, updates, and uninstall."],
        ["features", "Features", "Dictation, hotkeys, models, dictionary, recorder, and integrations."],
        ["file-transcription", "File Transcription", "Queue, formats, export, and watch folder."],
        ["workflows", "Workflows", "Templates, triggers, post-processing, and output."],
        ["api", "HTTP API", "Local API for transcription, dictation, recorder, and dictionary."],
        ["cli", "CLI Tool", "Use TypeWhisper from PowerShell and scripts."],
        ["troubleshooting", "Troubleshooting", "Diagnose installation, microphone, insertion, models, and API."],
      ],
    };
---
<DocsLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath(locale, "/docs/windows")}
  locale={locale}
  platform="windows"
  releaseStage="stable"
  releaseTitle={t(locale, "docs.win.release.title")}
  releaseDescription={t(locale, "docs.win.release.indexDescription")}
  heading={copy.heading}
  label={t(locale, "docs.title")}
  lede={copy.intro}
  wide
  prose={false}
>
  <Fragment slot="meta">
    <span class="docs-head__accent">{t(locale, "docs.win.badge")}</span>
  </Fragment>

  <DocsFigure
    kind="framed"
    src={screenshotPath(locale, "/screenshots/windows/dashboard.png")}
    alt={locale === "de" ? "TypeWhisper-Dashboard unter Windows" : "TypeWhisper dashboard on Windows"}
    loading="eager"
  />

  <ul class="docs-index">
    {(copy.cards as WindowsEntry[]).map(([slug, title, description]) => (
      <li>
        <a href={canonicalPath(locale, `/docs/windows/${slug}`)} class="docs-index__link">
          <span class="docs-index__name">{title}</span>
          <span class="docs-index__text">{description}</span>
          <ArrowRight aria-hidden="true" />
        </a>
      </li>
    ))}
  </ul>
</DocsLayout>
