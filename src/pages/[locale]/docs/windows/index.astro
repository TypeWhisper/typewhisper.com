---
import DocsLayout from "@/layouts/DocsLayout.astro";
import { Badge } from "@/components/ui/badge";
import { Card, CardHeader, CardTitle, CardDescription } from "@/components/ui/card";
import { Screenshot } from "@/components/ui/screenshot";
import { screenshotPath, t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";
import { Download, Globe, Settings, Sparkles } from "lucide-react";

interface Props {
  locale: Locale;
}

type WindowsCard = [slug: string, title: string, description: string, Icon: typeof Download];

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const copy = locale === "de"
  ? {
      title: "Windows-Dokumentation - TypeWhisper",
      description: "Dokumentation für TypeWhisper auf Windows.",
      heading: "Windows-Dokumentation",
      intro: "Die Windows-App ist stabil für den täglichen Einsatz mit systemweitem Diktat, Datei-Transkription, Workflows, Verlauf, Wörterbuch, Snippets und Integrationen.",
      cards: [
        ["installation", "Installation", "Installationsanleitung, Systemanforderungen und erster Start.", Download],
        ["features", "Funktionen", "Aktueller Funktionsumfang, Plattformgrenzen und Workflow-Hinweise.", Sparkles],
        ["api", "HTTP API", "Aktuelle API für lokale Tools und Automatisierung.", Globe],
        ["profiles", "Profile", "App- und seitenbezogene Einstellungen für den täglichen Einsatz.", Settings],
      ],
    }
  : {
      title: "Windows Documentation - TypeWhisper",
      description: "Documentation for TypeWhisper on Windows.",
      heading: "Windows Documentation",
      intro: "The Windows app is stable for daily use with system-wide dictation, file transcription, workflows, history, dictionary, snippets, and integrations.",
      cards: [
        ["installation", "Installation", "Install guide, system requirements, and first setup.", Download],
        ["features", "Features", "Current feature set, platform constraints, and workflow notes.", Sparkles],
        ["api", "HTTP API", "Current API surface for local tooling and automation.", Globe],
        ["profiles", "Profiles", "Per-app and per-site settings for daily use.", Settings],
      ],
    };
---
<DocsLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath(locale, "/docs/windows")}
  locale={locale}
  platform="windows"
  releaseStage="stable"
  releaseTitle={t(locale, "docs.win.release.title")}
  releaseDescription={t(locale, "docs.win.release.indexDescription")}
>
  <div>
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="font-display text-3xl font-bold tracking-tight">{copy.heading}</h1>
      <Badge variant="secondary">{locale === "de" ? "Stabil" : "Stable"}</Badge>
    </div>
    <p class="mt-3 max-w-3xl text-lg text-muted-foreground">
      {copy.intro}
    </p>
    <Screenshot
      src={screenshotPath(locale, "/screenshots/windows/dashboard.png")}
      alt={locale === "de" ? "TypeWhisper Windows-Dashboard" : "TypeWhisper Windows dashboard"}
      className="mt-8 aspect-[31/20] w-full rounded-xl border border-border object-cover"
      loading="eager"
    />
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {(copy.cards as WindowsCard[]).map(([slug, title, description, Icon]) => (
        <a href={canonicalPath(locale, `/docs/windows/${slug}`)}>
          <Card className="h-full transition-all hover:shadow-md">
            <CardHeader>
              <div class="mb-1 text-muted-foreground">
                <Icon className="size-5" />
              </div>
              <CardTitle className="text-base">{title}</CardTitle>
              <CardDescription>{description}</CardDescription>
            </CardHeader>
          </Card>
        </a>
      ))}
    </div>
  </div>
</DocsLayout>
