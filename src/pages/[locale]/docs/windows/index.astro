---
import DocsLayout from "@/layouts/DocsLayout.astro";
import { Badge } from "@/components/ui/badge";
import { Card, CardHeader, CardTitle, CardDescription } from "@/components/ui/card";
import { Screenshot } from "@/components/ui/screenshot";
import { screenshotPath, t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";
import { Download, FileAudio, Globe, Sparkles, Terminal, Workflow, Wrench } from "lucide-react";

interface Props {
  locale: Locale;
}

type WindowsCard = [slug: string, title: string, description: string, Icon: typeof Download];

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const copy = locale === "de"
  ? {
      title: "Windows-Dokumentation - TypeWhisper",
      description: "Dokumentation für TypeWhisper auf Windows.",
      heading: "Windows-Dokumentation",
      intro: "Die Windows-App ist stabil für den täglichen Einsatz mit systemweitem Diktat, Datei-Transkription, Workflows, Verlauf, Wörterbuch, Snippets und Integrationen.",
      cards: [
        ["installation", "Installation", "Store, Installer, vierstufiges Onboarding, Updates und Deinstallation.", Download],
        ["features", "Funktionen", "Diktat, Tastenkürzel, Modelle, Wörterbuch, Recorder und Integrationen.", Sparkles],
        ["file-transcription", "Datei-Transkription", "Queue, Formate, Export und Watch Folder.", FileAudio],
        ["workflows", "Workflows", "Vorlagen, Trigger, Nachbearbeitung und Ausgabe.", Workflow],
        ["api", "HTTP API", "Lokale API für Transkription, Diktat, Recorder und Wörterbuch.", Globe],
        ["cli", "CLI Tool", "TypeWhisper aus PowerShell und Skripten verwenden.", Terminal],
        ["troubleshooting", "Fehlerbehebung", "Installation, Mikrofon, Einfügen, Modelle und API diagnostizieren.", Wrench],
      ],
    }
  : {
      title: "Windows Documentation - TypeWhisper",
      description: "Documentation for TypeWhisper on Windows.",
      heading: "Windows Documentation",
      intro: "The Windows app is stable for daily use with system-wide dictation, file transcription, workflows, history, dictionary, snippets, and integrations.",
      cards: [
        ["installation", "Installation", "Store, installers, four-step onboarding, updates, and uninstall.", Download],
        ["features", "Features", "Dictation, hotkeys, models, dictionary, recorder, and integrations.", Sparkles],
        ["file-transcription", "File Transcription", "Queue, formats, export, and watch folder.", FileAudio],
        ["workflows", "Workflows", "Templates, triggers, post-processing, and output.", Workflow],
        ["api", "HTTP API", "Local API for transcription, dictation, recorder, and dictionary.", Globe],
        ["cli", "CLI Tool", "Use TypeWhisper from PowerShell and scripts.", Terminal],
        ["troubleshooting", "Troubleshooting", "Diagnose installation, microphone, insertion, models, and API.", Wrench],
      ],
    };
---
<DocsLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath(locale, "/docs/windows")}
  locale={locale}
  platform="windows"
  releaseStage="stable"
  releaseTitle={t(locale, "docs.win.release.title")}
  releaseDescription={t(locale, "docs.win.release.indexDescription")}
>
  <div>
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="font-display text-3xl font-bold tracking-tight">{copy.heading}</h1>
      <Badge variant="secondary">{t(locale, "docs.win.badge")}</Badge>
    </div>
    <p class="mt-3 max-w-3xl text-lg text-muted-foreground">
      {copy.intro}
    </p>
    <Screenshot
      src={screenshotPath(locale, "/screenshots/windows/dashboard.png")}
      alt={locale === "de" ? "TypeWhisper-Dashboard unter Windows" : "TypeWhisper dashboard on Windows"}
      className="mt-8 aspect-[31/20] w-full rounded-xl border border-border object-cover"
      loading="eager"
    />
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {(copy.cards as WindowsCard[]).map(([slug, title, description, Icon]) => (
        <a href={canonicalPath(locale, `/docs/windows/${slug}`)}>
          <Card className="h-full transition-all hover:shadow-md">
            <CardHeader>
              <div class="mb-1 text-muted-foreground">
                <Icon className="size-5" />
              </div>
              <CardTitle className="text-base">{title}</CardTitle>
              <CardDescription>{description}</CardDescription>
            </CardHeader>
          </Card>
        </a>
      ))}
    </div>
  </div>
</DocsLayout>
