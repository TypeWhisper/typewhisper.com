---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsWindowsInstallation from "@/pages/docs/windows/_installation.tsx";
import { t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const copy = locale === "de"
  ? {
      title: "Installation - Windows - TypeWhisper",
      description: "Installiere TypeWhisper für Windows. Systemanforderungen, Download und erste Einrichtung.",
    }
  : {
      title: "Installation - Windows - TypeWhisper",
      description: "Install TypeWhisper for Windows. System requirements, download, and first setup.",
    };
---
<DocsLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath(locale, "/docs/windows/installation")}
  locale={locale}
  platform="windows"
  releaseStage="stable"
  releaseTitle={t(locale, "docs.win.release.title")}
  releaseDescription={t(locale, "docs.win.release.installationDescription")}
>
  <DocsWindowsInstallation locale={locale} />
</DocsLayout>
