---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsWindowsInstallation from "@/pages/docs/windows/_installation.tsx";
import { type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const copy = locale === "de"
  ? {
      title: "Installation - Windows - TypeWhisper",
      description: "Installiere TypeWhisper für Windows. Systemanforderungen, Download und erste Einrichtung.",
      releaseTitle: "Windows ist ein stabiles Desktop-Release.",
      releaseDescription: "Installationsdetails, Onboarding-Ablauf und erste Einrichtung für Windows 10 und 11.",
    }
  : {
      title: "Installation - Windows - TypeWhisper",
      description: "Install TypeWhisper for Windows. System requirements, download, and first setup.",
      releaseTitle: "Windows is a stable desktop release.",
      releaseDescription: "Installation details, onboarding flow, and first setup for Windows 10 and 11.",
    };
---
<DocsLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath(locale, "/docs/windows/installation")}
  locale={locale}
  platform="windows"
  releaseStage="stable"
  releaseTitle={copy.releaseTitle}
  releaseDescription={copy.releaseDescription}
>
  <DocsWindowsInstallation locale={locale} />
</DocsLayout>
