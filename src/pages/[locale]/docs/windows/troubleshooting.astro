---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsWindowsTroubleshooting, { windowsTroubleshootingHead } from "@/pages/docs/windows/_troubleshooting.tsx";
import { t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const copy = locale === "de"
  ? {
      title: "Fehlerbehebung - Windows - TypeWhisper",
      description: "Typische TypeWhisper-Probleme bei Installation, Mikrofon, Einfügen, Modellen und API unter Windows lösen.",
    }
  : {
      title: "Troubleshooting - Windows - TypeWhisper",
      description: "Resolve common TypeWhisper installation, microphone, insertion, model, and API problems on Windows.",
    };
const head = windowsTroubleshootingHead(locale);
---
<DocsLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath(locale, "/docs/windows/troubleshooting")}
  locale={locale}
  platform="windows"
  heading={head.heading}
  lede={head.lede}
>
  <DocsWindowsTroubleshooting locale={locale} />
</DocsLayout>
