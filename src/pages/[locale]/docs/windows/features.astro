---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsWindowsFeatures from "@/pages/docs/windows/_features.tsx";
import { type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const copy = locale === "de"
  ? {
      title: "Funktionen - Windows Beta - TypeWhisper",
      description: "Aktuelle TypeWhisper Windows-Beta-Features: Diktiermodi, Datei-Transkription, Übersetzung und mehr.",
      releaseTitle: "Windows ist derzeit eine öffentliche Beta.",
      releaseDescription: "Diese Feature-Liste beschreibt den aktuellen Beta-Build. Rechne vor 1.0 noch mit Iterationen und Feinschliff.",
    }
  : {
      title: "Features - Windows Beta - TypeWhisper",
      description: "Current TypeWhisper Windows beta features: dictation modes, file transcription, translation, and more.",
      releaseTitle: "Windows is currently a public beta.",
      releaseDescription: "This feature list reflects the current beta build. Expect iteration and refinement before 1.0.",
    };
---
<DocsLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath(locale, "/docs/windows/features")}
  locale={locale}
  platform="windows"
  releaseStage="beta"
  releaseTitle={copy.releaseTitle}
  releaseDescription={copy.releaseDescription}
>
  <DocsWindowsFeatures locale={locale} />
</DocsLayout>
