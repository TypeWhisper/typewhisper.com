---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsWindowsCLI, { windowsCliHead } from "@/pages/docs/windows/_cli.tsx";
import { t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const copy = locale === "de"
  ? {
      title: "CLI Tool - Windows - TypeWhisper",
      description: "TypeWhisper über PowerShell und Skripte installieren und verwenden.",
    }
  : {
      title: "CLI Tool - Windows - TypeWhisper",
      description: "Install and use TypeWhisper from PowerShell and scripts.",
    };
const head = windowsCliHead(locale);
---
<DocsLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath(locale, "/docs/windows/cli")}
  locale={locale}
  platform="windows"
  heading={head.heading}
  lede={head.lede}
>
  <DocsWindowsCLI locale={locale} />
</DocsLayout>
