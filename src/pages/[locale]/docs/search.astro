---
import DocsLayout from "@/layouts/DocsLayout.astro";
import { DocsSearch } from "@/components/docs/docs-search";
import { t, type Locale } from "@/i18n/index";
import { getLocaleStaticPaths, canonicalPath } from "@/lib/locale-routes";
export const getStaticPaths = getLocaleStaticPaths;
const { locale } = Astro.props as { locale: Locale };
---

<DocsLayout
  title={`${t(locale, "docs.search.title")} - TypeWhisper`}
  description={t(locale, "docs.search.hint")}
  canonicalPath={canonicalPath(locale, "/docs/search")}
  locale={locale}
  heading={t(locale, "docs.search.title")}
  label={t(locale, "docs.title")}
  prose={false}
  search={false}
>
  <DocsSearch client:load locale={locale} />
</DocsLayout>
