---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsMacFeatures from "@/pages/docs/mac/_features.tsx";
import { t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
---
<DocsLayout
  title={t(locale, "docs.mac.features.meta.title")}
  description={t(locale, "docs.mac.features.meta.description")}
  canonicalPath={canonicalPath(locale, "/docs/mac/features")}
  locale={locale}
  platform="mac"
>
  <DocsMacFeatures locale={locale} />
</DocsLayout>
