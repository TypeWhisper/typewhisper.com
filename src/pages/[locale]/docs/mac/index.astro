---
import DocsLayout from "@/layouts/DocsLayout.astro";
import { Badge } from "@/components/ui/badge";
import { Card, CardHeader, CardTitle, CardDescription } from "@/components/ui/card";
import { t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";
import { Download, Globe, MessageCircle, Settings, Sparkles, Terminal } from "lucide-react";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const links = [
  { slug: "installation", Icon: Download },
  { slug: "features", Icon: Sparkles },
  { slug: "workflows", Icon: MessageCircle },
  { slug: "api", Icon: Globe },
  { slug: "cli", Icon: Terminal },
  { slug: "troubleshooting", Icon: Settings },
];
---
<DocsLayout
  title={t(locale, "docs.mac.index.meta.title")}
  description={t(locale, "docs.mac.index.meta.description")}
  canonicalPath={canonicalPath(locale, "/docs/mac")}
  locale={locale}
  platform="mac"
>
  <div>
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="font-display text-3xl font-bold tracking-tight">{t(locale, "docs.mac.index.title")}</h1>
      <Badge variant="secondary">{t(locale, "docs.mac.index.badge")}</Badge>
    </div>
    <p class="mt-3 max-w-3xl text-lg text-muted-foreground">
      {t(locale, "docs.mac.index.description")}
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {links.map(({ slug, Icon }) => (
        <a href={canonicalPath(locale, `/docs/mac/${slug}`)}>
          <Card className="h-full transition-all hover:shadow-md">
            <CardHeader>
              <div class="mb-1 text-muted-foreground">
                <Icon className="size-5" />
              </div>
              <CardTitle className="text-base">{t(locale, `docs.mac.index.${slug}.title`)}</CardTitle>
              <CardDescription>{t(locale, `docs.mac.index.${slug}.description`)}</CardDescription>
            </CardHeader>
          </Card>
        </a>
      ))}
    </div>
  </div>
</DocsLayout>
