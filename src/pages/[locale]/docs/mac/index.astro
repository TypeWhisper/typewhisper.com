---
import DocsLayout from "@/layouts/DocsLayout.astro";
import { t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";
import { ArrowRight } from "lucide-react";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const links = [
  "installation",
  "features",
  "workflows",
  "api",
  "cli",
  "troubleshooting",
].map((slug) => ({
  slug,
  title: t(locale, `docs.mac.index.${slug}.title`),
  description: t(locale, `docs.mac.index.${slug}.description`),
}));
// File transcription has its own page; its index entry uses the copy of that page.
links.splice(2, 0, {
  slug: "file-transcription",
  title: t(locale, "docs.mac.fileTranscription.title"),
  description: t(locale, "docs.mac.fileTranscription.subtitle"),
});
---
<DocsLayout
  title={t(locale, "docs.mac.index.meta.title")}
  description={t(locale, "docs.mac.index.meta.description")}
  canonicalPath={canonicalPath(locale, "/docs/mac")}
  locale={locale}
  platform="mac"
  heading={t(locale, "docs.mac.index.title")}
  label={t(locale, "docs.title")}
  lede={t(locale, "docs.mac.index.description")}
  wide
  prose={false}
>
  <Fragment slot="meta">
    <span class="docs-head__accent">{t(locale, "docs.mac.index.badge")}</span>
  </Fragment>

  <ul class="docs-index">
    {links.map(({ slug, title, description }) => (
      <li>
        <a href={canonicalPath(locale, `/docs/mac/${slug}`)} class="docs-index__link">
          <span class="docs-index__name">{title}</span>
          <span class="docs-index__text">{description}</span>
          <ArrowRight aria-hidden="true" />
        </a>
      </li>
    ))}
  </ul>
</DocsLayout>
