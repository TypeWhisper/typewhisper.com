---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsMacInstallation from "@/pages/docs/mac/_installation.tsx";
import { t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
---
<DocsLayout
  title={t(locale, "docs.mac.installation.meta.title")}
  description={t(locale, "docs.mac.installation.meta.description")}
  canonicalPath={canonicalPath(locale, "/docs/mac/installation")}
  locale={locale}
  platform="mac"
>
  <DocsMacInstallation locale={locale} client:load />
</DocsLayout>
