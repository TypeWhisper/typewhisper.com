---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsMacManagedSettings, {
  macManagedSettingsHead,
} from "@/pages/docs/mac/_managed-settings.tsx";
import { type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const copy = locale === "de"
  ? {
      title: "Verwaltete Einstellungen - macOS - TypeWhisper",
      description: "TypeWhisper für Mac mit Konfigurationsprofilen zentral steuern: Lizenz, Modelle, Cloud-Verarbeitung, Downloads und Updates mit Iru, Jamf Pro oder jedem MDM.",
    }
  : {
      title: "Managed Settings - macOS - TypeWhisper",
      description: "Control TypeWhisper for Mac centrally with configuration profiles: license, models, cloud processing, downloads, and updates with Iru, Jamf Pro, or any MDM.",
    };
const head = macManagedSettingsHead(locale);
---
<DocsLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath(locale, "/docs/mac/managed-settings")}
  locale={locale}
  platform="mac"
  heading={head.heading}
  lede={head.lede}
>
  <DocsMacManagedSettings locale={locale} />
</DocsLayout>
