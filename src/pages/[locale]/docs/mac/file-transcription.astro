---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsMacFileTranscription from "@/pages/docs/mac/_file-transcription.tsx";
import { t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
---
<DocsLayout
  title={t(locale, "docs.mac.fileTranscription.meta.title")}
  description={t(locale, "docs.mac.fileTranscription.meta.description")}
  canonicalPath={canonicalPath(locale, "/docs/mac/file-transcription")}
  locale={locale}
  platform="mac"
>
  <DocsMacFileTranscription locale={locale} />
</DocsLayout>
