---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsMacDeployment, {
  macDeploymentHead,
} from "@/pages/docs/mac/_deployment.tsx";
import { type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const copy = locale === "de"
  ? {
      title: "Bereitstellung - macOS - TypeWhisper",
      description: "TypeWhisper für Mac in Organisationen verteilen: Direkt-Download oder Mac App Store, Updates, Anmeldeobjekt, Berechtigungen per PPPC und Netzwerk-Hosts.",
    }
  : {
      title: "Deployment - macOS - TypeWhisper",
      description: "Roll out TypeWhisper for Mac across an organization: direct download or Mac App Store, updates, the login item, PPPC permissions, and network hosts.",
    };
const head = macDeploymentHead(locale);
---
<DocsLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath(locale, "/docs/mac/deployment")}
  locale={locale}
  platform="mac"
  heading={head.heading}
  lede={head.lede}
>
  <DocsMacDeployment locale={locale} />
</DocsLayout>
