---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsMacCLI from "@/pages/docs/mac/_cli.tsx";
import { t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
---
<DocsLayout
  title={t(locale, "docs.mac.cli.meta.title")}
  description={t(locale, "docs.mac.cli.meta.description")}
  canonicalPath={canonicalPath(locale, "/docs/mac/cli")}
  locale={locale}
  platform="mac"
  heading={t(locale, "docs.mac.cli.title")}
  lede={t(locale, "docs.mac.cli.description")}
>
  <DocsMacCLI locale={locale} />
</DocsLayout>
