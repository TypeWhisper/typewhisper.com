---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsIOSGuide from "@/pages/docs/ios/_guide";
import {
  getIosDocPage,
  iosDocSlugs,
  type IosDocSlug,
} from "@/data/ios-docs";
import { locales, type Locale } from "@/i18n/index";
import { canonicalPath } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
  section: IosDocSlug;
}

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    iosDocSlugs.map((section) => ({
      params: { locale, section },
      props: { locale, section },
    })),
  );
}

const { locale, section } = Astro.props;
const page = getIosDocPage(locale, section);
const status = locale === "de"
  ? {
      title: "iOS 1.0 wird noch für den App Store vorbereitet.",
      description: "Es gibt derzeit keinen öffentlichen Download und keinen bestätigten Veröffentlichungstermin.",
    }
  : {
      title: "iOS 1.0 is still being prepared for the App Store.",
      description: "There is currently no public download or confirmed release date.",
    };
---
<DocsLayout
  title={`${page.title} - iOS - TypeWhisper`}
  description={page.description}
  canonicalPath={canonicalPath(locale, `/docs/ios/${section}`)}
  locale={locale}
  platform="ios"
  releaseStage="pending"
  releaseTitle={status.title}
  releaseDescription={status.description}
>
  <DocsIOSGuide locale={locale} slug={section} />
</DocsLayout>
