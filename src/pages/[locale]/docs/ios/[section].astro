---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsIOSGuide from "@/pages/docs/ios/_guide";
import {
  getIosDocPage,
  iosDocSlugs,
  type IosDocSlug,
} from "@/data/ios-docs";
import { resolveVersions } from "@/data/versions";
import { locales, t, type Locale } from "@/i18n/index";
import { canonicalPath } from "@/lib/locale-routes";
import { getIosAppStoreUrl, iosVersion } from "@/lib/platform-download";

interface Props {
  locale: Locale;
  section: IosDocSlug;
}

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    iosDocSlugs.map((section) => ({
      params: { locale, section },
      props: { locale, section },
    })),
  );
}

const { locale, section } = Astro.props;
const page = getIosDocPage(locale, section);
const isDe = locale === "de";
---
<DocsLayout
  title={`${page.title} - iOS - TypeWhisper`}
  description={page.description}
  canonicalPath={canonicalPath(locale, `/docs/ios/${section}`)}
  locale={locale}
  platform="ios"
  heading={page.title}
  label={page.eyebrow}
  lede={resolveVersions(page.intro)}
>
  <Fragment slot="meta">
    <span>iOS / iPadOS 18+</span>
    <span>watchOS 11+</span>
    <span>
      {resolveVersions(
        isDe ? "Version {iosSeries} stabil" : "Version {iosSeries} stable",
      )}
    </span>
    <a
      href={getIosAppStoreUrl(locale)}
      target="_blank"
      rel="noopener noreferrer"
      data-download-social-trigger
      data-download-platform="ios"
      data-download-target="ios_app_store"
      data-download-version={iosVersion}
      data-tracking-placement="docs"
    >
      {isDe ? "App Store öffnen" : "Open the App Store"}
    </a>
  </Fragment>
  <DocsIOSGuide locale={locale} slug={section} />
</DocsLayout>
