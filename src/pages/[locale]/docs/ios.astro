---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsIOS from "@/pages/docs/_ios.tsx";
import { type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const copy = locale === "de"
  ? {
      description: "Ausführliche TypeWhisper-Anleitung für iPhone, iPad und Apple Watch: Einrichtung, Diktier-Tastatur, Profile, Capture Inbox, Dateien, Kurzbefehle, Datenschutz, Premium und Fehlerbehebung.",
      releaseTitle: "iOS 1.0 wird noch für den App Store vorbereitet.",
      releaseDescription: "Es gibt derzeit keinen öffentlichen Download und keinen bestätigten Veröffentlichungstermin.",
    }
  : {
      description: "Complete TypeWhisper guidance for iPhone, iPad, and Apple Watch: setup, voice keyboard, profiles, Capture Inbox, files, Shortcuts, privacy, Premium, and troubleshooting.",
      releaseTitle: "iOS 1.0 is still being prepared for the App Store.",
      releaseDescription: "There is currently no public download or confirmed release date.",
    };
---
<DocsLayout
  title="iOS - TypeWhisper"
  description={copy.description}
  canonicalPath={canonicalPath(locale, "/docs/ios")}
  locale={locale}
  platform="ios"
  releaseStage="pending"
  releaseTitle={copy.releaseTitle}
  releaseDescription={copy.releaseDescription}
>
  <DocsIOS locale={locale} />
</DocsLayout>
