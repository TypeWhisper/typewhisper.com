---
import DocsLayout from "@/layouts/DocsLayout.astro";
import DocsIOS from "@/pages/docs/_ios.tsx";
import { type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const copy = locale === "de"
  ? {
      description: "TypeWhisper für iPhone und iPad wurde bei Apple eingereicht und wartet auf die Freigabe für den App Store.",
      releaseTitle: "Das iOS-Release wartet auf Apples Prüfung.",
      releaseDescription: "TypeWhisper erscheint im App Store, sobald Apple die Prüfung abgeschlossen und das Release freigegeben hat.",
    }
  : {
      description: "TypeWhisper for iPhone and iPad has been submitted to Apple and is waiting for App Store approval.",
      releaseTitle: "The iOS release is pending Apple review.",
      releaseDescription: "TypeWhisper will appear in the App Store once Apple completes its review and approves the release.",
    };
---
<DocsLayout
  title="iOS - TypeWhisper"
  description={copy.description}
  canonicalPath={canonicalPath(locale, "/docs/ios")}
  locale={locale}
  releaseStage="pending"
  releaseTitle={copy.releaseTitle}
  releaseDescription={copy.releaseDescription}
>
  <DocsIOS locale={locale} />
</DocsLayout>
