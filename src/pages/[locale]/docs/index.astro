---
import DocsLayout from "@/layouts/DocsLayout.astro";
import {
  docsPlatformPath,
  docsPlatforms,
  getDocsNav,
  type DocsPlatform,
} from "@/components/docs/navigation";
import { resolveVersions } from "@/data/versions";
import { t, type Locale } from "@/i18n/index";
import { IOSLogo, MacOSLogo, WindowsLogo } from "@/components/ui/platform-logos";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";
import { ArrowRight } from "lucide-react";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const metaDescription = resolveVersions(
  locale === "de"
    ? "TypeWhisper-Dokumentation für die stabilen Releases auf macOS {macSeries}, Windows {windowsVersion} und iOS {iosVersion}."
    : "TypeWhisper documentation for the stable macOS {macSeries}, Windows {windowsVersion}, and iOS {iosVersion} releases.",
);

const copy: Record<DocsPlatform, { key: string; Logo: typeof MacOSLogo }> = {
  mac: { key: "docs.mac", Logo: MacOSLogo },
  windows: { key: "docs.win", Logo: WindowsLogo },
  ios: { key: "docs.ios", Logo: IOSLogo },
};
---

<DocsLayout
  title={`${t(locale, "docs.title")} - TypeWhisper`}
  description={metaDescription}
  canonicalPath={canonicalPath(locale, "/docs")}
  locale={locale}
  heading={t(locale, "docs.title")}
  label="TypeWhisper"
  lede={t(locale, "docs.subtitle")}
  prose={false}
>
  <Fragment slot="actions">
    <a href={`/${locale}/setup/`} class="site-link">
      {t(locale, "setup.title")}
      <ArrowRight className="size-4" aria-hidden="true" />
    </a>
  </Fragment>

  <ul class="docs-index docs-index--platforms">
    {docsPlatforms.map((platform) => {
      const { key, Logo } = copy[platform];
      const title = t(locale, `${key}.title`);
      return (
        <li class="docs-platform">
          <a href={docsPlatformPath(locale, platform)} class="docs-platform__link">
            <span class="docs-platform__mark">
              <Logo aria-hidden="true" />
            </span>
            <span class="docs-platform__name">
              {title}
              <span class="docs-platform__badge">{t(locale, `${key}.badge`)}</span>
            </span>
            <span class="docs-platform__text">{t(locale, `${key}.description`)}</span>
          </a>
          <ul
            class="docs-platform__pages"
            aria-label={t(locale, "docs.index.allPages").replace("{platform}", title)}
          >
            {getDocsNav(locale, platform).slice(1).map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </li>
      );
    })}
  </ul>
</DocsLayout>
