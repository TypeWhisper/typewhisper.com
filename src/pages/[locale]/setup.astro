---
import "@/styles/utility.css";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageHead } from "@/components/site";
import { SetupAssistant } from "@/components/setup/setup-assistant";
import { t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";
export const getStaticPaths = getLocaleStaticPaths;
const { locale } = Astro.props as { locale: Locale };
---

<BaseLayout
  title={`${t(locale, "setup.title")} - TypeWhisper`}
  description={t(locale, "setup.subtitle")}
  canonicalPath={canonicalPath(locale, "/setup")}
  locale={locale}
>
  <div class="site-page">
    <PageHead
      label={t(locale, "setup.label")}
      title={t(locale, "setup.title")}
      lede={t(locale, "setup.subtitle")}
    />
    <section class="site-section site-section--tight-top">
      <div class="site-wrap">
        <SetupAssistant client:load locale={locale} />
      </div>
    </section>
  </div>
</BaseLayout>
