---
import { closeSync, openSync, readSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/commercial.css";
import { ArrowRight, Download } from "lucide-react";
import { BarMark, PageHead, SectionHead, WaveRule } from "@/components/site";
import { Screenshot } from "@/components/ui/screenshot";
import { t, localePath, screenshotPath, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";
import { salesEmail } from "@/lib/pricing";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const key = (name: string) => t(locale, `openSourceAccessibility.${name}`);
const contactHref = `mailto:${salesEmail}?subject=${encodeURIComponent("TypeWhisper Open Source & Accessibility Initiative")}`;
const onePagerHref =
  locale === "de"
    ? "/downloads/typewhisper-open-source-accessibility-one-pager-de.pdf"
    : "/downloads/typewhisper-open-source-accessibility-one-pager-en.pdf";

// Width by height of a capture, read from the header of the PNG file.
const proportion = (src: string) => {
  try {
    const file = openSync(join(process.cwd(), "public", src), "r");
    const header = Buffer.alloc(24);
    readSync(file, header, 0, 24, 0);
    closeSync(file);
    const ratio = header.readUInt32BE(16) / header.readUInt32BE(20);
    return Number.isFinite(ratio) && ratio > 0 ? ratio : 1.25;
  } catch {
    return 1.25;
  }
};

const screenshots = [
  {
    src: screenshotPath(locale, "/screenshots/mac/file-transcription.png"),
    alt: key("screenshot.fileTranscription.alt"),
    label: key("screenshot.fileTranscription.label"),
  },
  {
    src: screenshotPath(locale, "/screenshots/mac/workflows.png"),
    alt: key("screenshot.workflows.alt"),
    label: key("screenshot.workflows.label"),
  },
].map((screenshot) => ({ ...screenshot, proportion: proportion(screenshot.src) }));

const pair = (group: string, names: string[]) =>
  names.map((name) => ({
    title: key(`${group}.${name}.title`),
    description: key(`${group}.${name}.description`),
  }));

const principles = pair("principle", ["local", "assistive", "open", "honest"]);
const buildingBlocks = pair("block", ["speech", "workflows", "integrations", "guides"]);
const statusGroups = pair("status", ["available", "planned", "wanted"]);
const impactMetrics = ["typing", "workflows", "docs", "local", "barriers"].map((name) =>
  key(`impact.${name}`),
);
// "Users: people who …" reads as a name and its description.
const audiences = ["users", "organizations", "builders"].map((name) => {
  const text = key(`audience.${name}`);
  const cut = text.indexOf(": ");
  return cut > 0
    ? { name: text.slice(0, cut), text: text.slice(cut + 2) }
    : { name: "", text };
});
const partnerTypes = ["accessibility", "foundations", "research", "opensource", "employers"].map(
  (name) => key(`partner.${name}`),
);
---

<BaseLayout
  title={key("meta.title")}
  description={key("meta.description")}
  canonicalPath={canonicalPath(locale, "/open-source-accessibility")}
  locale={locale}
>
  <div class="site-page commercial">
    <PageHead
      label={key("hero.eyebrow")}
      title={key("hero.title")}
      lede={key("hero.subtitle")}
      meta={key("hero.initiative")}
      className="commercial-initiative"
    >
      <a href={contactHref} class="site-button">{key("hero.cta")}</a>
      <a href={onePagerHref} download class="site-button site-button--quiet">
        <Download className="size-4" aria-hidden="true" />
        {key("hero.secondary")}
      </a>
      <a href={localePath(locale, "/sponsors")} class="site-link">
        {key("hero.sponsorLink")}
        <ArrowRight className="size-4" aria-hidden="true" />
      </a>
    </PageHead>

    <section class="site-section site-section--tight-top">
      <div class="site-wrap">
        <WaveRule label={key("screenshot.label")} seed={5} />
        <div class="commercial-shots">
          {screenshots.map((screenshot, index) => (
            <figure
              class="site-shot site-shot--window reveal-hidden"
              style={`--commercial-shot: ${screenshot.proportion.toFixed(4)}`}
            >
              <Screenshot
                src={screenshot.src}
                alt={screenshot.alt}
                loading={index === 0 ? "eager" : "lazy"}
                sizes="(max-width: 767px) calc(100vw - 40px), 560px"
              />
              <figcaption class="site-caption">{screenshot.label}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section site-section--rule">
      <div class="site-wrap">
        <WaveRule label={key("problem.label")} seed={7} />
        <div class="site-split">
          <h2 class="site-title site-title--start reveal-hidden">{key("problem.title")}</h2>
          <p class="commercial-statement reveal-hidden">{key("problem.description")}</p>
        </div>
        <div class="site-split commercial-next">
          <h2 class="site-title site-title--start reveal-hidden">{key("approach.title")}</h2>
          <p class="commercial-statement reveal-hidden">{key("approach.description")}</p>
        </div>
      </div>
    </section>

    <section class="site-section site-section--band">
      <div class="site-wrap">
        <SectionHead
          label={key("principles.label")}
          title={key("principles.title")}
          lede={key("principles.subtitle")}
          seed={11}
        />
        <ul class="site-grid site-grid--4 reveal-hidden">
          {principles.map((principle) => (
            <li class="site-grid__item">
              <h3 class="site-heading">{principle.title}</h3>
              <p class="site-text">{principle.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="site-section">
      <div class="site-wrap">
        <WaveRule label={key("blocks.eyebrow")} seed={13} />
        <div class="site-split">
          <div class="site-split__head reveal-hidden">
            <h2 class="site-title site-title--start">{key("blocks.title")}</h2>
            <p class="site-lede site-lede--start">{key("blocks.subtitle")}</p>
          </div>
          <ul class="site-points">
            {buildingBlocks.map((block) => (
              <li class="site-points__item">
                <BarMark className="site-points__mark" />
                <div>
                  <h3 class="site-points__title">{block.title}</h3>
                  <p class="site-points__text">{block.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="site-section site-section--rule">
      <div class="site-wrap">
        <WaveRule label={key("impact.label")} seed={17} />
        <div class="site-split">
          <div class="site-split__head reveal-hidden">
            <h2 class="site-title site-title--start">{key("impact.title")}</h2>
            <p class="site-lede site-lede--start">{key("impact.subtitle")}</p>
          </div>
          <ul class="commercial-rows commercial-rows--flush">
            {impactMetrics.map((metric) => (
              <li>
                <BarMark />
                <span>{metric}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="site-section site-section--rule">
      <div class="site-wrap">
        <WaveRule label={key("audience.label")} seed={19} />
        <div class="commercial-columns">
          <div class="reveal-hidden">
            <h2 class="site-title site-title--start">{key("audience.title")}</h2>
            <p class="site-text">{key("audience.subtitle")}</p>
            <ul class="commercial-rows">
              {audiences.map((audience) => (
                <li>
                  <BarMark />
                  <span>
                    {audience.name && <strong>{audience.name}: </strong>}
                    <span class="commercial-rows__more">{audience.text}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
          <div class="reveal-hidden">
            <h2 class="site-title site-title--start">{key("partners.title")}</h2>
            <p class="site-text">{key("partners.subtitle")}</p>
            <ul class="commercial-rows">
              {partnerTypes.map((partner) => (
                <li>
                  <BarMark />
                  <span>{partner}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="site-section site-section--band">
      <div class="site-wrap">
        <SectionHead label={key("status.label")} title={key("status.title")} seed={23} />
        <ul class="site-grid commercial-trio reveal-hidden">
          {statusGroups.map((group) => (
            <li class="site-grid__item">
              <h3 class="site-heading">{group.title}</h3>
              <p class="site-text">{group.description}</p>
            </li>
          ))}
        </ul>
        <p class="site-footnote commercial-legal-note">{key("legalNote")}</p>
      </div>
    </section>

    <section class="site-section">
      <div class="site-wrap">
        <WaveRule label={key("cta.label")} seed={29} />
        <div class="site-split">
          <h2 class="site-title site-title--start reveal-hidden">{key("cta.title")}</h2>
          <div class="reveal-hidden">
            <p class="commercial-statement">{key("cta.subtitle")}</p>
            <div class="site-actions site-actions--start">
              <a href={contactHref} class="site-button">{key("cta.email")}</a>
              <a href={onePagerHref} download class="site-button site-button--quiet">
                <Download className="size-4" aria-hidden="true" />
                {key("cta.onePager")}
              </a>
              <a href={localePath(locale, "/sponsors")} class="site-link">
                {key("cta.sponsors")}
                <ArrowRight className="size-4" aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
