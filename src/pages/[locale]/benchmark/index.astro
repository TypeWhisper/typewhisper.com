---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";
import BenchmarkPage from "@/pages/benchmark/_index.tsx";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
---

<BaseLayout
  title={t(locale, "benchmark.title")}
  description={t(locale, "benchmark.description")}
  canonicalPath={canonicalPath(locale, "/benchmark")}
  locale={locale}
>
  <BenchmarkPage client:only="react" />
</BaseLayout>
