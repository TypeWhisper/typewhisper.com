---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ReleaseStageNotice from "@/components/docs/release-stage-notice.astro";
import { t, localePath, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";
import { getWindowsStoreUrl, macDmgUrl, windowsSetupUrl } from "@/lib/platform-download";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const windowsStoreUrl = getWindowsStoreUrl(locale);
---

<BaseLayout
  title={`${t(locale, "releaseStatus.title")} - TypeWhisper`}
  description={t(locale, "releaseStatus.meta.description")}
  canonicalPath={canonicalPath(locale, "/release-status")}
  locale={locale}
>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:py-16">
    <h1 class="font-display text-3xl font-bold tracking-tight">{t(locale, "releaseStatus.title")}</h1>
    <p class="mt-3 max-w-3xl text-lg text-muted-foreground">
      {t(locale, "releaseStatus.subtitle")}
    </p>

    <div class="mt-10 space-y-6">
      <ReleaseStageNotice
        stage="stable"
        title={t(locale, "releaseStatus.mac.intro")}
        description={t(locale, "releaseStatus.mac.detail")}
      />

      <ReleaseStageNotice
        stage="stable"
        title={t(locale, "releaseStatus.win.intro")}
        description={t(locale, "releaseStatus.win.detail")}
      />

      <ReleaseStageNotice
        stage="pending"
        title={t(locale, "releaseStatus.ios.intro")}
        description={t(locale, "releaseStatus.ios.detail")}
      />
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      <section class="rounded-2xl border bg-card p-6">
        <h2 class="text-lg font-semibold">{t(locale, "releaseStatus.mac.title")}</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          {t(locale, "releaseStatus.mac.description")}
        </p>
        <div class="mt-4 flex flex-col gap-2 text-sm">
          <a href={macDmgUrl} data-download-social-trigger data-download-platform="mac" data-download-target="mac_dmg" data-tracking-placement="release_status" class="text-primary hover:underline">{t(locale, "releaseStatus.mac.download")}</a>
          <a href={localePath(locale, "/docs/mac")} class="text-primary hover:underline">{t(locale, "releaseStatus.mac.docs")}</a>
        </div>
      </section>

      <section class="rounded-2xl border bg-card p-6">
        <h2 class="text-lg font-semibold">{t(locale, "releaseStatus.win.title")}</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          {t(locale, "releaseStatus.win.description")}
        </p>
        <div class="mt-4 flex flex-col gap-2 text-sm">
          <a href={windowsStoreUrl} target="_blank" rel="noopener noreferrer" data-download-social-trigger data-download-platform="windows" data-download-target="windows_store" data-tracking-placement="release_status" class="text-primary hover:underline">{t(locale, "releaseStatus.win.download")}</a>
          <a href={windowsSetupUrl} data-download-social-trigger data-download-platform="windows" data-download-target="windows_github_installer" data-tracking-placement="release_status" class="text-primary hover:underline">{t(locale, "releaseStatus.win.githubInstaller")}</a>
          <a href={localePath(locale, "/docs/windows")} class="text-primary hover:underline">{t(locale, "releaseStatus.win.docs")}</a>
        </div>
      </section>

      <section class="rounded-2xl border bg-card p-6">
        <h2 class="text-lg font-semibold">{t(locale, "releaseStatus.ios.title")}</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          {t(locale, "releaseStatus.ios.description")}
        </p>
        <div class="mt-4 flex flex-col gap-2 text-sm">
          <span class="font-medium text-muted-foreground">{t(locale, "releaseStatus.ios.download")}</span>
          <a href={localePath(locale, "/docs/ios")} class="text-primary hover:underline">{t(locale, "releaseStatus.ios.docs")}</a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
