---
import "@/styles/utility.css";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ArrowRight, ArrowUpRight, Download } from "lucide-react";
import { BarMark, PageHead } from "@/components/site";
import { t, localePath, type Locale } from "@/i18n/index";
import { androidBeta } from "@/lib/android-beta";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";
import {
  getWindowsStoreUrl,
  getIosAppStoreUrl,
  iosVersion,
  macDmgUrl,
  windowsSetupUrl,
} from "@/lib/platform-download";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;

interface StatusLink {
  label: string;
  href: string;
  kind: "download" | "store" | "docs";
  attributes?: Record<string, string>;
}

/** One block per edition: stage, what it means, what it contains, where to get it. */
const editions: {
  id: "mac" | "win" | "ios" | "android";
  stage: "stable" | "beta";
  links: StatusLink[];
}[] = [
  {
    id: "mac",
    stage: "stable",
    links: [
      {
        label: t(locale, "releaseStatus.mac.download"),
        href: macDmgUrl,
        kind: "download",
        attributes: {
          "data-download-social-trigger": "",
          "data-download-platform": "mac",
          "data-download-target": "mac_dmg",
          "data-tracking-placement": "release_status",
        },
      },
      {
        label: t(locale, "releaseStatus.mac.docs"),
        href: localePath(locale, "/docs/mac"),
        kind: "docs",
      },
    ],
  },
  {
    id: "win",
    stage: "stable",
    links: [
      {
        label: t(locale, "releaseStatus.win.download"),
        href: getWindowsStoreUrl(locale),
        kind: "store",
        attributes: {
          "data-download-social-trigger": "",
          "data-download-platform": "windows",
          "data-download-target": "windows_store",
          "data-tracking-placement": "release_status",
        },
      },
      {
        label: t(locale, "releaseStatus.win.githubInstaller"),
        href: windowsSetupUrl,
        kind: "download",
        attributes: {
          "data-download-social-trigger": "",
          "data-download-platform": "windows",
          "data-download-target": "windows_github_installer",
          "data-tracking-placement": "release_status",
        },
      },
      {
        label: t(locale, "releaseStatus.win.docs"),
        href: localePath(locale, "/docs/windows"),
        kind: "docs",
      },
    ],
  },
  {
    id: "ios",
    stage: "stable",
    links: [
      {
        label: t(locale, "releaseStatus.ios.download"),
        href: getIosAppStoreUrl(locale),
        kind: "store",
        attributes: {
          "data-download-social-trigger": "",
          "data-download-platform": "ios",
          "data-download-target": "ios_app_store",
          "data-download-version": iosVersion,
          "data-tracking-placement": "release_status",
        },
      },
      {
        label: t(locale, "releaseStatus.ios.docs"),
        href: localePath(locale, "/docs/ios"),
        kind: "docs",
      },
    ],
  },
  ...(androidBeta.listed
    ? [
        {
          id: "android" as const,
          stage: "beta" as const,
          links: [
            {
              label: t(locale, "releaseStatus.android.join"),
              href: localePath(locale, "/android"),
              kind: "docs" as const,
            },
          ],
        },
      ]
    : []),
];
---

<BaseLayout
  title={`${t(locale, "releaseStatus.title")} - TypeWhisper`}
  description={t(locale, "releaseStatus.meta.description")}
  canonicalPath={canonicalPath(locale, "/release-status")}
  locale={locale}
>
  <div class="site-page">
    <PageHead
      label={t(locale, "releaseStatus.label")}
      title={t(locale, "releaseStatus.title")}
      lede={t(locale, "releaseStatus.subtitle")}
    />

    <section class="site-section site-section--tight-top">
      <div class="site-wrap">
        <ul class="utility-status" aria-label={t(locale, "releaseStatus.listLabel")}>
          {editions.map((edition) => (
            <li class="utility-status__item" data-testid={`release-status-${edition.id}`}>
              <div class="utility-status__head">
                <p class="site-label">
                  <BarMark />
                  {t(locale, `releaseStage.${edition.stage}`)}
                </p>
                <h2 class="site-subtitle">{t(locale, `releaseStatus.${edition.id}.title`)}</h2>
              </div>
              <div class="utility-status__body">
                <p class="utility-status__intro">{t(locale, `releaseStatus.${edition.id}.intro`)}</p>
                <p class="site-text">{t(locale, `releaseStatus.${edition.id}.detail`)}</p>
                <p class="site-text">{t(locale, `releaseStatus.${edition.id}.description`)}</p>
              </div>
              <ul class="utility-links utility-status__links">
                {edition.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="site-link"
                      target={link.kind === "store" ? "_blank" : undefined}
                      rel={link.kind === "store" ? "noopener noreferrer" : undefined}
                      {...link.attributes}
                    >
                      {link.kind === "download" && <Download className="size-4" aria-hidden="true" />}
                      {link.label}
                      {link.kind === "store" && <ArrowUpRight className="size-4" aria-hidden="true" />}
                      {link.kind === "docs" && <ArrowRight className="size-4" aria-hidden="true" />}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
