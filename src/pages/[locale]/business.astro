---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/commercial.css";
import { ArrowRight } from "lucide-react";
import { BarMark, PageHead, SectionHead, WaveRule } from "@/components/site";
import { Price } from "@/components/pricing/price";
import { commercialTier, fill } from "@/components/pricing/format";
import { t, localePath, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";
import { salesEmail } from "@/lib/pricing";
import { macDmgUrl } from "@/lib/platform-download";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;

const teamTier = commercialTier("team");
const enterpriseTier = commercialTier("enterprise");

const features = [
  "deviceManagement",
  "adminProfiles",
  "customEngines",
  "compliance",
  "prioritySupport",
  "auditable",
].map((key) => ({
  title: t(locale, `business.feature.${key}.title`),
  description: fill(t(locale, `business.feature.${key}.description`), {
    count: teamTier.devices,
  }),
}));

const trust = ["local", "gpl", "noTelemetry"];
---

<BaseLayout
  title={t(locale, "business.meta.title")}
  description={t(locale, "business.meta.description")}
  canonicalPath={canonicalPath(locale, "/business")}
  locale={locale}
>
  <div class="site-page commercial">
    <PageHead
      label={t(locale, "business.hero.badge")}
      title={t(locale, "business.hero.title")}
      lede={t(locale, "business.hero.subtitle")}
    >
      <a href={`mailto:${salesEmail}`} class="site-button">{t(locale, "business.hero.ctaSales")}</a>
      <a href={localePath(locale, "/pricing")} class="site-link">
        {t(locale, "business.hero.ctaPricing")}
        <ArrowRight className="size-4" aria-hidden="true" />
      </a>
    </PageHead>

    <section class="site-section site-section--tight-top">
      <div class="site-wrap">
        <SectionHead
          label={t(locale, "business.features.label")}
          title={t(locale, "business.features.title")}
          lede={t(locale, "business.features.subtitle")}
          seed={7}
        />
        <ul class="site-grid reveal-hidden">
          {features.map((feature) => (
            <li class="site-grid__item">
              <h3 class="site-heading">{feature.title}</h3>
              <p class="site-text">{feature.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="site-section site-section--band">
      <div class="site-wrap">
        <WaveRule label={t(locale, "business.trust.label")} seed={11} />
        <div class="site-split">
          <div class="site-split__head reveal-hidden">
            <h2 class="site-title site-title--start">{t(locale, "business.trust.title")}</h2>
            <p class="site-lede site-lede--start">{t(locale, "business.trust.subtitle")}</p>
          </div>
          <div>
            <ul class="site-points">
              {trust.map((key) => (
                <li class="site-points__item">
                  <BarMark className="site-points__mark" />
                  <div>
                    <h3 class="site-points__title">{t(locale, `business.trust.${key}.title`)}</h3>
                    <p class="site-points__text">{t(locale, `business.trust.${key}.description`)}</p>
                  </div>
                </li>
              ))}
            </ul>
            <div class="site-callout commercial-review">
              <p>{t(locale, "business.trust.review.description")}</p>
              <a href={localePath(locale, "/business/legal-security-review")} class="site-link">
                {t(locale, "business.trust.review.cta")}
                <ArrowRight className="size-4" aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="site-section">
      <div class="site-wrap">
        <SectionHead
          label={t(locale, "business.pricing.label")}
          title={t(locale, "business.pricing.title")}
          lede={t(locale, "business.pricing.subtitle")}
          seed={13}
        />
        <ul class="site-tiers site-tiers--2 reveal-hidden">
          <li>
            <div class="site-tiers__link commercial-tier">
              <h3 class="site-tiers__name">{t(locale, "pricing.tiers.team.name")}</h3>
              <Price
                locale={locale}
                from
                amount={teamTier.price.monthly}
                suffix={t(locale, "pricing.tiers.perMonth")}
              />
              <p class="site-tiers__text">
                {fill(t(locale, "business.pricing.teamDevices"), { count: teamTier.devices })}
              </p>
              <a
                href={teamTier.checkout.monthly}
                target="_blank"
                rel="noopener noreferrer"
                class="site-button site-button--small commercial-tier__action"
                data-checkout-tier="team"
                data-checkout-billing-period="monthly"
                data-tracking-placement="business"
              >
                {t(locale, "business.pricing.startTeam")}
              </a>
            </div>
          </li>
          <li>
            <div class="site-tiers__link commercial-tier">
              <h3 class="site-tiers__name">{t(locale, "pricing.tiers.enterprise.name")}</h3>
              <Price
                locale={locale}
                from
                amount={enterpriseTier.price.monthly}
                suffix={t(locale, "pricing.tiers.perMonth")}
              />
              <p class="site-tiers__text">{t(locale, "business.pricing.enterpriseDevices")}</p>
              <a
                href={`mailto:${salesEmail}`}
                class="site-button site-button--small commercial-tier__action"
              >
                {t(locale, "business.pricing.contactSales")}
              </a>
            </div>
          </li>
        </ul>
        <p class="site-more">
          <a href={localePath(locale, "/pricing")} class="site-link">
            {t(locale, "business.pricing.seeAll")}
            <ArrowRight className="size-4" aria-hidden="true" />
          </a>
        </p>
      </div>
    </section>

    <section class="site-section site-section--rule">
      <div class="site-wrap">
        <SectionHead
          label={t(locale, "business.finalCta.label")}
          title={t(locale, "business.finalCta.title")}
          lede={t(locale, "business.finalCta.subtitle")}
          seed={17}
        />
        <div class="site-actions">
          <a
            href={macDmgUrl}
            class="site-button"
            data-download-social-trigger
            data-download-platform="mac"
            data-download-target="mac_dmg"
            data-tracking-placement="business"
          >
            {t(locale, "business.finalCta.download")}
          </a>
          <a href={`mailto:${salesEmail}`} class="site-button site-button--quiet">
            {t(locale, "business.finalCta.contact")}
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
