---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Hero } from "@/components/landing/hero";
import { TrustStrip } from "@/components/landing/trust-strip";
import { WhyTypeWhisper } from "@/components/landing/why-typewhisper";
import { Features } from "@/components/landing/features";
import { PremiumFeatures } from "@/components/landing/premium-features";
import { HowItWorks } from "@/components/landing/how-it-works";
import { UseCasesTeaser } from "@/components/landing/use-cases-teaser";
import { AddonsShowcase } from "@/components/landing/addons-showcase";
import { EngineComparison } from "@/components/landing/engine-comparison";
import { WallOfLove } from "@/components/landing/wall-of-love";
import { PricingTeaser } from "@/components/landing/pricing-teaser";
import { LandingFaq, getLandingFaq } from "@/components/landing/landing-faq";
import { DownloadCTA } from "@/components/landing/download-cta";
import { t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const path = canonicalPath(locale, "/");
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "TypeWhisper",
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "macOS, Windows, iOS",
      description: t(locale, "structuredData.description"),
      inLanguage: locale,
      url: `https://www.typewhisper.com${path}`,
      offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
    },
    {
      "@type": "FAQPage",
      inLanguage: locale,
      mainEntity: getLandingFaq(locale).map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<BaseLayout
  title={t(locale, "landing.title")}
  description={t(locale, "landing.description")}
  canonicalPath={path}
  locale={locale}
  structuredData={structuredData}
>
  <Hero locale={locale} client:load />
  <TrustStrip locale={locale} />
  <WhyTypeWhisper locale={locale} />
  <HowItWorks locale={locale} client:visible />
  <Features locale={locale} client:visible />
  <div class="bg-background pb-12 sm:pb-16">
    <details class="mx-auto w-full max-w-6xl px-4 sm:px-6">
      <summary
        class="mx-auto flex w-fit cursor-pointer list-none items-center gap-2 rounded-full border border-border bg-card px-5 py-2.5 text-sm font-semibold text-foreground transition-colors hover:border-primary/40 [&::-webkit-details-marker]:hidden"
        >{t(locale, "landing.compareEngines")}</summary
      >
      <EngineComparison locale={locale} client:visible />
    </details>
  </div>
  <UseCasesTeaser locale={locale} />
  <AddonsShowcase locale={locale} />
  <WallOfLove locale={locale} />
  <PremiumFeatures locale={locale} client:visible />
  <PricingTeaser locale={locale} />
  <LandingFaq locale={locale} />
  <DownloadCTA locale={locale} client:load />
</BaseLayout>
