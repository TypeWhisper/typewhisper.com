---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/landing.css";
import { Plus } from "lucide-react";
import { Hero } from "@/components/landing/hero";
import { Trust } from "@/components/landing/trust";
import { Spoken } from "@/components/landing/spoken";
import { Video } from "@/components/landing/video";
import { Why } from "@/components/landing/why";
import { FeatureTour } from "@/components/landing/feature-tour";
import { Engines } from "@/components/landing/engines";
import { UseCases } from "@/components/landing/use-cases";
import { Addons } from "@/components/landing/addons";
import { Press } from "@/components/landing/press";
import { Premium } from "@/components/landing/premium";
import { Pricing } from "@/components/landing/pricing";
import { Faq, getLandingFaq } from "@/components/landing/faq";
import { FinalCta } from "@/components/landing/final-cta";
import { t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const path = canonicalPath(locale, "/");
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "TypeWhisper",
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "macOS, Windows, iOS",
      description: t(locale, "structuredData.description"),
      inLanguage: locale,
      url: `https://www.typewhisper.com${path}`,
      offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
    },
    {
      "@type": "FAQPage",
      inLanguage: locale,
      mainEntity: getLandingFaq(locale).map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<BaseLayout
  title={t(locale, "landing.title")}
  description={t(locale, "landing.description")}
  canonicalPath={path}
  locale={locale}
  structuredData={structuredData}
>
  <noscript>
    <style is:inline>
      .landing .landing-hero__title {
        opacity: 1 !important;
        animation: none !important;
      }
    </style>
  </noscript>
  <div class="site-page landing">
    <Hero locale={locale} client:load />
    <Trust locale={locale} />
    <Spoken locale={locale} />
    <Video locale={locale} client:visible />
    <Why locale={locale} />
    <FeatureTour locale={locale} client:visible />
    <div class="landing-engines">
      <details class="site-wrap">
        <summary>
          {t(locale, "landing.compareEngines")}
          <Plus className="size-4" aria-hidden="true" />
        </summary>
        <Engines locale={locale} client:visible />
      </details>
    </div>
    <UseCases locale={locale} />
    <Addons locale={locale} />
    <Press locale={locale} />
    <Premium locale={locale} client:visible />
    <Pricing locale={locale} />
    <Faq locale={locale} />
    <FinalCta locale={locale} client:load />
  </div>
</BaseLayout>
