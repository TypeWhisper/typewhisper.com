---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/commercial.css";
import { LegalSecurityReviewHero } from "@/components/business/legal-security-review/legal-security-review-hero";
import { LegalSecurityReviewChecklist } from "@/components/business/legal-security-review/legal-security-review-checklist";
import { LegalSecurityReviewDataFlow } from "@/components/business/legal-security-review/legal-security-review-data-flow";
import { LegalSecurityReviewBoundaries } from "@/components/business/legal-security-review/legal-security-review-boundaries";
import { LegalSecurityReviewRelated } from "@/components/business/legal-security-review/legal-security-review-related";
import { LegalSecurityReviewCTA } from "@/components/business/legal-security-review/legal-security-review-cta";
import { getLegalSecurityReviewModule } from "@/data/legal-security-review";
import { t, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const mod = getLegalSecurityReviewModule(locale);
const content = mod.frontmatter;
const label = (key: string) => t(locale, `business.legalSecurityReview.${key}.label`);
---

<BaseLayout
  title={content.meta.title}
  description={content.meta.description}
  canonicalPath={canonicalPath(locale, "/business/legal-security-review")}
  locale={locale}
>
  <div class="site-page commercial">
    <LegalSecurityReviewHero hero={content.hero} locale={locale} />
    <LegalSecurityReviewChecklist checklist={content.checklist} label={label("checklist")} />
    <LegalSecurityReviewDataFlow dataFlow={content.dataFlow} label={label("dataFlow")} />
    <LegalSecurityReviewBoundaries boundaries={content.boundaries} label={label("boundaries")} />
    <LegalSecurityReviewRelated related={content.related} locale={locale} label={label("related")} />
    <LegalSecurityReviewCTA cta={content.cta} locale={locale} label={label("cta")} />
  </div>
</BaseLayout>
