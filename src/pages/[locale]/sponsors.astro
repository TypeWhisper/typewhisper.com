---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/commercial.css";
import { ArrowRight, ArrowUpRight } from "lucide-react";
import { BarMark, PageHead, SectionHead, WaveRule } from "@/components/site";
import { t, localePath, type Locale } from "@/i18n/index";
import { canonicalPath, getLocaleStaticPaths } from "@/lib/locale-routes";
import { salesEmail } from "@/lib/pricing";
import { sponsorsByKind, type Sponsor } from "@/data/sponsors";

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props;
const sponsorMailto = `mailto:${salesEmail}?subject=${encodeURIComponent("TypeWhisper sponsorship")}`;

const sponsorModels = ["oss", "ecosystem"].map((key) => ({
  title: t(locale, `sponsors.model.${key}.title`),
  description: t(locale, `sponsors.model.${key}.description`),
}));

const rules = [
  { key: "criteria", items: ["privacy", "opensource", "ai", "accessibility"] },
  { key: "visibility", items: ["website", "context", "noAds", "noLicense"] },
].map(({ key, items }) => ({
  title: t(locale, `sponsors.${key}.title`),
  subtitle: t(locale, `sponsors.${key}.subtitle`),
  items: items.map((item) => t(locale, `sponsors.${key}.${item}`)),
}));

const placementDetails = ["page", "logo", "label"].map((key) =>
  t(locale, `sponsors.placement.detail.${key}`),
);

const groupedSponsors: { title: string; sponsors: Sponsor[] }[] = [
  {
    title: t(locale, "sponsors.current.ossTitle"),
    sponsors: sponsorsByKind("oss-funder"),
  },
  {
    title: t(locale, "sponsors.current.ecosystemTitle"),
    sponsors: sponsorsByKind("ecosystem-partner"),
  },
].filter((group) => group.sponsors.length > 0);
---

<BaseLayout
  title={t(locale, "sponsors.meta.title")}
  description={t(locale, "sponsors.meta.description")}
  canonicalPath={canonicalPath(locale, "/sponsors")}
  locale={locale}
>
  <div class="site-page commercial">
    <PageHead
      label={t(locale, "sponsors.hero.eyebrow")}
      title={t(locale, "sponsors.hero.title")}
      lede={t(locale, "sponsors.hero.subtitle")}
    >
      <a href={sponsorMailto} class="site-button">{t(locale, "sponsors.hero.cta")}</a>
      <a href={localePath(locale, "/pricing")} class="site-link">
        {t(locale, "sponsors.hero.secondary")}
        <ArrowRight className="size-4" aria-hidden="true" />
      </a>
    </PageHead>

    <section class="site-section site-section--tight-top">
      <div class="site-wrap">
        <SectionHead
          label={t(locale, "sponsors.models.label")}
          title={t(locale, "sponsors.models.title")}
          lede={t(locale, "sponsors.models.subtitle")}
          seed={7}
        />
        <ul class="site-grid site-grid--2 reveal-hidden">
          {sponsorModels.map((model) => (
            <li class="site-grid__item">
              <h3 class="site-heading">{model.title}</h3>
              <p class="site-text">{model.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="site-section site-section--band">
      <div class="site-wrap">
        <WaveRule label={t(locale, "sponsors.placement.eyebrow")} seed={11} />
        <div class="site-split">
          <div class="reveal-hidden">
            <h2 class="site-title site-title--start">{t(locale, "sponsors.placement.title")}</h2>
            <p class="site-lede site-lede--start">{t(locale, "sponsors.placement.subtitle")}</p>
            <ul class="site-list commercial-example__details">
              {placementDetails.map((item) => (
                <li>
                  <BarMark />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <figure class="commercial-example reveal-hidden">
            <figcaption class="commercial-example__label">
              <span class="site-label">
                <BarMark />
                {t(locale, "sponsors.placement.exampleBadge")}
              </span>
              <span class="site-meta">{t(locale, "sponsors.placement.exampleNote")}</span>
            </figcaption>
            <div class="commercial-example__entry">
              <span class="site-index__mark" aria-hidden="true">
                <BarMark />
              </span>
              <div class="site-index__body">
                <p class="site-index__name">{t(locale, "sponsors.placement.exampleName")}</p>
                <p class="site-index__text">{t(locale, "sponsors.placement.exampleDescription")}</p>
                <p class="commercial-example__link">
                  {t(locale, "sponsors.placement.exampleLink")}
                  <ArrowUpRight className="size-4" aria-hidden="true" />
                </p>
              </div>
            </div>
          </figure>
        </div>
      </div>
    </section>

    <section class="site-section">
      <div class="site-wrap">
        <WaveRule label={t(locale, "sponsors.criteria.label")} seed={13} />
        <div class="commercial-columns">
          {rules.map((rule) => (
            <div class="reveal-hidden">
              <h2 class="site-title site-title--start">{rule.title}</h2>
              <p class="site-text">{rule.subtitle}</p>
              <ul class="commercial-rows">
                {rule.items.map((item) => (
                  <li>
                    <BarMark />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="site-section site-section--rule">
      <div class="site-wrap">
        <WaveRule label={t(locale, "sponsors.grants.label")} seed={17} />
        <div class="site-split">
          <h2 class="site-title site-title--start reveal-hidden">{t(locale, "sponsors.grants.title")}</h2>
          <div class="reveal-hidden">
            <p class="commercial-statement">{t(locale, "sponsors.grants.subtitle")}</p>
            <div class="site-actions site-actions--start">
              <a href={localePath(locale, "/open-source-accessibility")} class="site-button site-button--quiet">
                {t(locale, "sponsors.grants.cta")}
                <ArrowRight className="size-4" aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    {groupedSponsors.length > 0 && (
      <section class="site-section site-section--rule">
        <div class="site-wrap">
          <SectionHead
            label={t(locale, "sponsors.current.label")}
            title={t(locale, "sponsors.current.title")}
            seed={9}
          />
          {groupedSponsors.map((group) => (
            <div class="commercial-sponsors">
              <h3 class="site-label site-label--muted">
                <BarMark />
                {group.title}
              </h3>
              <ul class="site-index site-index--tiles site-index--open">
                {group.sponsors.map((sponsor) => (
                  <li>
                    <a
                      href={sponsor.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="site-index__link"
                    >
                      <span class="site-index__mark" aria-hidden="true">
                        {sponsor.logo ? (
                          <img class="site-index__logo" src={sponsor.logo} alt="" loading="lazy" />
                        ) : (
                          <BarMark />
                        )}
                      </span>
                      <span class="site-index__body">
                        <span class="site-index__name">{sponsor.name}</span>
                        <span class="site-index__text">{sponsor.description}</span>
                        {sponsor.since && (
                          <span class="site-index__meta">
                            {t(locale, "sponsors.current.since").replace("{since}", sponsor.since)}
                          </span>
                        )}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="site-section site-section--rule">
      <div class="site-wrap">
        <SectionHead
          label={t(locale, "sponsors.cta.label")}
          title={t(locale, "sponsors.cta.title")}
          lede={t(locale, "sponsors.cta.subtitle")}
          seed={19}
        />
        <div class="site-actions">
          <a href={sponsorMailto} class="site-button">{t(locale, "sponsors.cta.email")}</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
