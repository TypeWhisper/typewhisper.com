---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t, getLocaleFromPath, localePath } from "@/i18n/index";

const locale = getLocaleFromPath(Astro.url.pathname);
---
<BaseLayout
  title={`${t(locale, "notFound.title")} - TypeWhisper`}
  description={t(locale, "notFound.description")}
  canonicalPath="/404"
  locale={locale}
>
  <div class="mx-auto flex min-h-[60vh] max-w-md flex-col items-center justify-center px-4 text-center">
    <p class="text-6xl font-bold text-primary font-display">{t(locale, "notFound.title")}</p>
    <h1 class="mt-4 text-2xl font-bold">{t(locale, "notFound.heading")}</h1>
    <p class="mt-2 text-muted-foreground">{t(locale, "notFound.description")}</p>
    <a href={localePath(locale, "/")} class="mt-6 inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      {t(locale, "notFound.backHome")}
    </a>
  </div>
</BaseLayout>
