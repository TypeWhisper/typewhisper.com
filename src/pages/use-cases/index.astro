---
// Redirect to locale-prefixed version
---
<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function() {
        var lang = (navigator.language || "en").toLowerCase();
        var locale = lang.startsWith("de") ? "de" : "en";
        window.location.replace("/" + locale + "/use-cases");
      })();
    </script>
    <meta http-equiv="refresh" content="0;url=/en/use-cases" />
  </head>
  <body></body>
</html>
