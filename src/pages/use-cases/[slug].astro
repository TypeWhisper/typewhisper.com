---
import LocalizedRedirect from "@/components/LocalizedRedirect.astro";
import { getUseCaseModules } from "@/data/use-cases";

export function getStaticPaths() {
  return getUseCaseModules("en").map((mod) => ({ params: { slug: mod.frontmatter.slug } }));
}

const { slug } = Astro.params;
---
<LocalizedRedirect path={`/use-cases/${slug}`} />
