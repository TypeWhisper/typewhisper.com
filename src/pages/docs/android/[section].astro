---
import LocalizedRedirect from "@/components/LocalizedRedirect.astro";
import { androidDocSlugs, type AndroidDocSlug } from "@/data/android-docs";

interface Props {
  section: AndroidDocSlug;
}

export function getStaticPaths() {
  return androidDocSlugs.map((section) => ({
    params: { section },
    props: { section },
  }));
}

const { section } = Astro.props;
---
<LocalizedRedirect path={`/docs/android/${section}`} />
