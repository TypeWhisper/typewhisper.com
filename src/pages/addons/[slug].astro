---
import LocalizedRedirect from "@/components/LocalizedRedirect.astro";
import { getPlugins } from "@/data/addons";

export function getStaticPaths() {
  return getPlugins("en").map((plugin) => ({ params: { slug: plugin.slug } }));
}

const { slug } = Astro.params;
---
<LocalizedRedirect path={`/addons/${slug}`} />
