---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AddonsIndex from "@/pages/addons/_index.tsx";
import { getPlugins } from "@/data/addons";

const allPlugins = getPlugins("de");
---
<BaseLayout
  title="Add-ons - TypeWhisper"
  description="Extend TypeWhisper with cloud transcription, LLM providers, automations, and more."
  canonicalPath="/de/addons"
  locale="de"
>
  <AddonsIndex client:load locale="de" allPlugins={allPlugins} basePath="/de/addons" />
</BaseLayout>
