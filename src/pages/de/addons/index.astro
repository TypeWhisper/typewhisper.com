---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AddonsIndex from "@/pages/addons/_index.tsx";
import { getPlugins } from "@/data/addons";
import { t } from "@/i18n/index";

const locale = "de";
const allPlugins = getPlugins(locale);
---
<BaseLayout
  title={t(locale, "addons.title")}
  description={t(locale, "addons.description")}
  canonicalPath="/de/addons"
  locale={locale}
>
  <AddonsIndex client:load locale={locale} allPlugins={allPlugins} basePath="/de/addons" />
</BaseLayout>
