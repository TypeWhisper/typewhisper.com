---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PricingIndex from "@/pages/pricing/_index";
import { t } from "@/i18n/index";

const locale = "de";
---

<BaseLayout
  title={t(locale, "pricing.meta.title")}
  description={t(locale, "pricing.meta.description")}
  canonicalPath="/de/pricing"
  locale={locale}
>
  <PricingIndex client:load locale={locale} />
</BaseLayout>
